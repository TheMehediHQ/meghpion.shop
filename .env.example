# ==========================================
# Meghpiyon Monorepo Environment Configuration
# ==========================================

# ------------------------------------------
# Frontend (apps/web/.env)
# ------------------------------------------
PUBLIC_API_URL=http://localhost:5000/api/v1

# Firebase Authentication (Client)
PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id

# Meta Pixel (Facebook Pixel)
PUBLIC_META_PIXEL_ID=your_facebook_pixel_id

# ------------------------------------------
# Backend (apps/api/.env)
# ------------------------------------------
PORT=5000
NODE_ENV=development
# MongoDB URI (Local or MongoDB Atlas Cloud)
MONGODB_URI=mongodb://127.0.0.1:27017/meghpiyon
CORS_ORIGIN=http://localhost:3000
API_PREFIX=/api/v1
