{
  "name": "@meghpiyon/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun --filter @meghpiyon/shared build && tsc --noEmit && bun run build:clean && bun run build:server && bun run bundle:vercel",
    "build:clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:server": "bun build src/server.ts --target=node --platform=node --format=esm --external=express --external=cors --external=helmet --external=mongoose --external=zod --external=dotenv --outfile=dist/server.js",
    "bundle:vercel": "bun build src/index.ts --target=node --platform=node --format=cjs --outfile=dist/_vercel.cjs && node -e \"require('fs').writeFileSync('dist/app.cjs', 'if (false) require(\\'express\\');\\nconst mod = require(\\'./_vercel.cjs\\');\\nmodule.exports = mod.default || mod;\\n')\"",
    "seed": "bun src/scripts/seed.ts",
    "admin:create": "bun src/scripts/create-superadmin.ts",
    "start": "bun dist/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@meghpiyon/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.10",
    "typescript": "^5.7.3"
  }
}
