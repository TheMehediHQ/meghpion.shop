---
interface Props {
  className?: string;
  src?: string;
}

const { className = '', src } = Astro.props;
---

{src ? (
  <img src={src} alt="" class={className} loading="lazy" decoding="async" />
) : (
  <svg class={className} viewBox="0 0 140 190" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id="brass-scale" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#eccf87"/>
        <stop offset="55%" stop-color="#c19a4b"/>
        <stop offset="100%" stop-color="#77560f"/>
      </linearGradient>
    </defs>
    <!-- base -->
    <ellipse cx="70" cy="182" rx="34" ry="5" fill="#5f440f" opacity="0.55"/>
    <path d="M45 180H95L88 166H52Z" fill="url(#brass-scale)" stroke="#5f440f" stroke-width="2"/>
    <!-- column -->
    <rect x="66" y="56" width="8" height="112" fill="url(#brass-scale)" stroke="#5f440f" stroke-width="1.6"/>
    <circle cx="70" cy="52" r="6.5" fill="url(#brass-scale)" stroke="#5f440f" stroke-width="1.8"/>
    <!-- beam -->
    <rect x="16" y="42" width="108" height="6.5" rx="3.25" fill="url(#brass-scale)" stroke="#5f440f" stroke-width="1.8"/>
    <circle cx="70" cy="45" r="5" fill="#c19a4b" stroke="#5f440f" stroke-width="1.6"/>
    <!-- chains -->
    <g stroke="#8a6420" stroke-width="1.6">
      <path d="M24 49L14 96M24 49L34 96"/>
      <path d="M116 49L106 96M116 49L126 96"/>
    </g>
    <!-- pans -->
    <path d="M6 96H44L38 110H12Z" fill="url(#brass-scale)" stroke="#5f440f" stroke-width="1.8"/>
    <ellipse cx="25" cy="96" rx="19" ry="3.4" fill="#e6c87e" stroke="#5f440f" stroke-width="1.4"/>
    <path d="M96 96H134L128 110H102Z" fill="url(#brass-scale)" stroke="#5f440f" stroke-width="1.8"/>
    <ellipse cx="115" cy="96" rx="19" ry="3.4" fill="#e6c87e" stroke="#5f440f" stroke-width="1.4"/>
    <!-- weights on right pan -->
    <g stroke="#5f440f" stroke-width="1.3">
      <rect x="105" y="84" width="11" height="9" rx="1" fill="#a37c2c"/>
      <rect x="119" y="86" width="9" height="7" rx="1" fill="#8a6420"/>
    </g>
  </svg>
)}