---
interface Props {
  variant?: 'green' | 'maroon';
  className?: string;
  src?: string;
}

const { variant = 'green', className = '', src } = Astro.props;

const isGreen = variant === 'green';
const ink = isGreen ? '#3f5a34' : '#8a2432';
const denom = isGreen ? '25' : '10';
---

{src ? (
  <img src={src} alt="" class={className} loading="lazy" decoding="async" />
) : (
  <div class={`stamp-perf relative ${isGreen ? 'bg-[#e3e6d2]' : 'bg-[#f1e6cc]'} border ${isGreen ? 'border-[#3f5a34]/70' : 'border-[#8a2432]/70'} ${className}`}>
    <div class={`absolute inset-[5px] border border-dashed ${isGreen ? 'border-[#3f5a34]/60' : 'border-[#8a2432]/60'} flex flex-col items-center justify-between py-1.5`}>
      <span class="font-serif font-bold text-[7px] tracking-[0.14em]" style={`color:${ink}`}>MEGHPIYON</span>
      {isGreen ? (
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" style={`color:${ink}`} aria-hidden="true">
          <path d="M12 21V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          <path d="M12 13C9 13 6 11 5 8C8 8 11 10 12 13Z" fill="currentColor" opacity="0.85"/>
          <path d="M12 10C15 10 18 8 19 5C16 5 13 7 12 10Z" fill="currentColor" opacity="0.85"/>
          <path d="M12 17C9 17 7 15 6 13C9 13 11 15 12 17Z" fill="currentColor" opacity="0.7"/>
        </svg>
      ) : (
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" style={`color:${ink}`} aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.4" stroke-dasharray="2.5 2"/>
          <text x="12" y="16" text-anchor="middle" font-family="Georgia, serif" font-size="11" fill="currentColor">M</text>
        </svg>
      )}
      <span class="text-[7px] tracking-widest" style={`color:${ink}`}>POSTAGE {denom}</span>
    </div>
  </div>
)}