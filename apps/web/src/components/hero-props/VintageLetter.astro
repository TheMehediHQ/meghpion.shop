---
interface Props {
  className?: string;
  src?: string;
}

const { className = '', src } = Astro.props;
---

{src ? (
  <img src={src} alt="" class={className} loading="lazy" decoding="async" />
) : (
  <svg class={className} viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect x="3" y="3" width="214" height="144" rx="3" fill="#efe3c8" stroke="#d3c3a0" stroke-width="2"/>
    <!-- postmark -->
    <g transform="translate(166 42)" stroke="#5c3a2e" fill="none" opacity="0.6">
      <circle r="18" stroke-width="1.6" stroke-dasharray="4 3"/>
      <circle r="12.5" stroke-width="1"/>
      <path d="M-44 0H-24M-40 -7H-24M-40 7H-24" stroke-width="1.4"/>
    </g>
    <!-- stamp -->
    <g transform="translate(24 20) rotate(-3)">
      <rect width="36" height="44" rx="1" fill="#f4ecd8" stroke="#8a2432" stroke-width="2" stroke-dasharray="4 3"/>
      <circle cx="18" cy="18" r="8.5" stroke="#8a2432" stroke-width="1.4" fill="none"/>
      <text x="18" y="22" text-anchor="middle" font-family="Georgia, serif" font-size="10" fill="#8a2432">M</text>
      <text x="18" y="36" text-anchor="middle" font-family="Georgia, serif" font-size="5.5" letter-spacing="1" fill="#6b5a3e">POSTAGE</text>
    </g>
    <!-- address lines -->
    <g stroke="#8a7a5c" stroke-width="2" opacity="0.75">
      <path d="M42 88H176"/>
      <path d="M42 102H152"/>
      <path d="M42 116H116"/>
    </g>
  </svg>
)}