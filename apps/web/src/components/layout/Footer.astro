---
import Container from '../ui/Container.astro';
import { BRAND, BD_DIVISIONS } from '@meghpiyon/shared';

const currentYear = new Date().getFullYear();

const exploreLinks = [
  { href: '/shop', label: 'All Gifts' },
  { href: '/shop?category=gift-boxes', label: 'Curated Hampers' },
  { href: '/shop?category=customized', label: 'Personalised Keepsakes' },
  { href: '/shop?category=handicrafts', label: 'Handicrafts & Nakshi' },
  { href: '/shop?category=chocolates', label: 'Artisan Chocolates' },
  { href: '/shop?category=flowers', label: 'Fresh & Dried Flowers' },
];

const careLinks = [
  { href: '/track-order', label: 'Track Your Parcel' },
  { href: '/cart', label: 'Shopping Bag' },
  { href: '/about', label: 'Our Story' },
  { href: '/contact', label: 'Contact & Support' },
  { href: '/login', label: 'Patron Sign In' },
];

const payments = ['bKash', 'Nagad', 'Visa', 'COD'];
---

<footer class="mt-auto bg-ink-deep text-parchment/70">
  <div class="h-[2px] w-full airmail-stripe"></div>

  <Container size="lg" className="py-16">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-12">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-4">
        <a href="/" class="inline-block" aria-label={`${BRAND.name} — home`}>
          <img
            src="/images/logo.png"
            alt={`${BRAND.name}.shop`}
            class="h-[60px] w-auto object-contain"
            width="182"
            height="60"
          />
        </a>

        <p class="mt-5 font-tiro text-sm text-gold-200/90">{BRAND.tagline}</p>
        <p class="mt-3 max-w-xs font-bengali text-[13px] leading-relaxed text-parchment/60">
          প্রিয়জনের জন্য হাতে তৈরি ভালোবাসার উপহার ও চিরকুট—যত্নে মোড়ানো, পৌঁছে যায় দেশের প্রতিটি প্রান্তে।
        </p>

        <div class="mt-6 flex items-center gap-2.5">
          {[
            { label: 'Instagram', path: 'M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5zm5 5.5a4.5 4.5 0 100 9 4.5 4.5 0 000-9zM17.5 6a1 1 0 100 2 1 1 0 000-2z' },
            { label: 'Facebook', path: 'M14 8h3V4h-3c-2.8 0-5 2.2-5 5v2H6v4h3v7h4v-7h3l1-4h-4V9c0-.6.4-1 1-1z' },
            { label: 'WhatsApp', path: 'M12 2a10 10 0 00-8.6 15L2 22l5.2-1.4A10 10 0 1012 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a13 13 0 01-5.9-5.2c-.4-.7-.6-1.4-.4-2 .1-.5.7-1.5 1.3-1.7.3-.1.7-.1.9.2l.9 1.7c.1.3 0 .6-.2.8l-.5.6c-.2.2-.2.4 0 .7a9 9 0 003.3 3c.3.1.5.1.7-.1l.7-.8c.2-.2.5-.3.8-.2l1.8.8c.3.2.4.5.2.9z' },
          ].map((social) => (
            <a
              key={social.label}
              href="/contact"
              aria-label={social.label}
              class="grid h-9 w-9 place-items-center rounded-full border border-parchment/[0.15] text-parchment/60 transition-colors hover:border-gold-500/60 hover:text-gold-300"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d={social.path} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Explore -->
      <div class="md:col-span-2">
        <h3 class="text-[10px] font-semibold uppercase tracking-[0.24em] text-gold-300">Explore</h3>
        <ul class="mt-4 space-y-2.5">
          {exploreLinks.map((link) => (
            <li>
              <a href={link.href} class="text-[13px] text-parchment/[0.55] transition-colors hover:text-gold-200">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Client care -->
      <div class="md:col-span-2">
        <h3 class="text-[10px] font-semibold uppercase tracking-[0.24em] text-gold-300">Client Care</h3>
        <ul class="mt-4 space-y-2.5">
          {careLinks.map((link) => (
            <li>
              <a href={link.href} class="text-[13px] text-parchment/[0.55] transition-colors hover:text-gold-200">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div class="col-span-2 md:col-span-4">
        <h3 class="text-[10px] font-semibold uppercase tracking-[0.24em] text-gold-300">The Atelier</h3>
        <ul class="mt-4 space-y-3 text-[13px] text-parchment/[0.55]">
          <li class="flex gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-500/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21s7-5.5 7-11a7 7 0 10-14 0c0 5.5 7 11 7 11z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
            <span>{BRAND.address}</span>
          </li>
          <li class="flex gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-500/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 5c0 9 6 15 15 15l1.5-3.5-4-2-1.5 2A11 11 0 017.5 9l2-1.5-2-4L4 5z" />
            </svg>
            <a href={`tel:${BRAND.supportPhone}`} class="transition-colors hover:text-gold-200">{BRAND.supportPhone}</a>
          </li>
          <li class="flex gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold-500/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="3" y="5" width="18" height="14" rx="2" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 7l9 6 9-6" />
            </svg>
            <a href={`mailto:${BRAND.supportEmail}`} class="break-all transition-colors hover:text-gold-200">{BRAND.supportEmail}</a>
          </li>
        </ul>

        <p class="mt-6 text-[10px] font-semibold uppercase tracking-[0.24em] text-gold-300">Delivery Across All Divisions</p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {BD_DIVISIONS.map((division) => (
            <span key={division} class="rounded-[2px] border border-parchment/10 bg-white/[0.03] px-2 py-0.5 text-[10px] text-parchment/50">
              {division}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-14 flex flex-col items-center justify-between gap-5 border-t border-parchment/10 pt-6 sm:flex-row">
      <p class="text-[11.5px] text-parchment/[0.35]">
        © {currentYear} {BRAND.name} ({BRAND.nameBn}). All rights reserved.
      </p>

      <div class="flex items-center gap-2">
        {payments.map((method) => (
          <span key={method} class="rounded-[2px] border border-parchment/[0.12] px-2.5 py-1 text-[10px] font-medium uppercase tracking-[0.1em] text-parchment/50">
            {method}
          </span>
        ))}
      </div>

      <div class="flex items-center gap-4 text-[11.5px] text-parchment/[0.35]">
        <a href="/contact" class="transition-colors hover:text-gold-200">Privacy</a>
        <span class="h-3 w-px bg-parchment/[0.15]"></span>
        <a href="/contact" class="transition-colors hover:text-gold-200">Terms</a>
      </div>
    </div>
  </Container>
</footer>