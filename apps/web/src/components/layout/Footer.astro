---
import Container from '../ui/Container.astro';
import { BRAND, BD_DIVISIONS } from '@meghpiyon/shared';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto bg-slate-900 text-slate-300 border-t border-slate-800">
  <Container size="lg" className="py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Col 1: Brand & Tagline -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-sky-500 text-white flex items-center justify-center font-bold text-base">
            ম
          </div>
          <div>
            <span class="text-xl font-bold tracking-tight text-white leading-none">
              {BRAND.name}
            </span>
            <span class="ml-1.5 text-xs text-sky-400 font-bengali">
              {BRAND.nameBn}
            </span>
          </div>
        </div>

        <p class="text-sm text-slate-400 font-bengali text-base leading-relaxed">
          {BRAND.tagline}
        </p>

        <p class="text-xs text-slate-400 leading-relaxed max-w-sm">
          Curated gift collections, personalized presents, and handcrafted treasures designed to celebrate relationships across Bangladesh with elegance and care.
        </p>

        <!-- Nationwide delivery badge -->
        <div class="pt-2">
          <p class="text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Coverage Across All Divisions
          </p>
          <div class="flex flex-wrap gap-1.5">
            {BD_DIVISIONS.map((division) => (
              <span class="px-2 py-0.5 text-[11px] rounded bg-slate-800 text-sky-300 border border-slate-700">
                {division}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase">
          Explore
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/shop" class="hover:text-sky-400">All Gifts</a></li>
          <li><a href="/shop?category=gift-boxes" class="hover:text-sky-400">Curated Gift Boxes</a></li>
          <li><a href="/shop?category=customized" class="hover:text-sky-400">Personalized Gifts</a></li>
          <li><a href="/shop?category=handicrafts" class="hover:text-sky-400">Handicrafts & Nakshi Kantha</a></li>
          <li><a href="/shop?category=chocolates" class="hover:text-sky-400">Chocolates & Sweets</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase">
          Assistance
        </h3>
        <ul class="space-y-2 text-xs">
          <li><a href="/track-order" class="hover:text-sky-400">Track Your Order</a></li>
          <li><a href="/cart" class="hover:text-sky-400">Shopping Cart</a></li>
          <li><a href="/about" class="hover:text-sky-400">Our Story</a></li>
          <li><a href="/contact" class="hover:text-sky-400">Contact & Support</a></li>
          <li><a href="/login" class="hover:text-sky-400">Account Login</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Payment Info -->
      <div class="space-y-3">
        <h3 class="text-sm font-semibold text-white tracking-wider uppercase">
          Contact Us
        </h3>
        <ul class="space-y-2 text-xs text-slate-400">
          <li>
            <span class="text-slate-300">Hotline:</span>{' '}
            <a href={`tel:${BRAND.supportPhone}`} class="hover:text-sky-400">{BRAND.supportPhone}</a>
          </li>
          <li>
            <span class="text-slate-300">Email:</span>{' '}
            <a href={`mailto:${BRAND.supportEmail}`} class="hover:text-sky-400">{BRAND.supportEmail}</a>
          </li>
          <li>
            <span class="text-slate-300">Location:</span> {BRAND.address}
          </li>
        </ul>

        <div class="pt-2">
          <p class="text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Payment Options
          </p>
          <div class="flex items-center gap-2 text-xs text-slate-400">
            <span class="px-2 py-1 rounded bg-slate-800 border border-slate-700 font-medium text-pink-400">bKash</span>
            <span class="px-2 py-1 rounded bg-slate-800 border border-slate-700 font-medium text-orange-400">Nagad</span>
            <span class="px-2 py-1 rounded bg-slate-800 border border-slate-700 font-medium text-emerald-400">COD</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-10 pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© {currentYear} {BRAND.name} ({BRAND.nameBn}). All rights reserved.</p>
      <p class="font-bengali text-slate-400">{BRAND.tagline}</p>
    </div>
  </Container>
</footer>
