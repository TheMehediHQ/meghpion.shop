---
import Container from '../ui/Container.astro';
import { BRAND, BD_DIVISIONS } from '@meghpiyon/shared';

const currentYear = new Date().getFullYear();
---

<footer class="mt-auto bg-[#170305] text-[#d6c4a3] border-t border-[#3b0b12] relative overflow-hidden">
  <!-- Subtle top airmail border accent -->
  <div class="h-1 w-full airmail-stripe opacity-75"></div>

  <Container size="lg" className="py-14">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Col 1: Brand & Tagline -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-full bg-gradient-to-br from-gold-300 to-gold-600 text-crimson-950 flex items-center justify-center font-serif font-black text-lg shadow-md border border-gold-300/40">
            ম
          </div>
          <div>
            <span class="font-cinzel text-xl font-bold tracking-widest text-gold-gradient leading-none">
              {BRAND.name}
            </span>
            <span class="ml-2 text-xs text-gold-300 font-bengali">
              {BRAND.nameBn}
            </span>
          </div>
        </div>

        <p class="text-sm text-gold-200/90 font-bengali font-medium leading-relaxed">
          {BRAND.tagline}
        </p>

        <p class="text-xs text-[#baa78d] font-serif leading-relaxed max-w-sm">
          Curated gift collections, vintage postal keepsakes, personalized presents, and handcrafted treasures designed to celebrate relationships across Bangladesh with elegance and care.
        </p>

        <!-- Nationwide delivery badge -->
        <div class="pt-2">
          <p class="text-[11px] font-cinzel font-semibold text-gold-300 uppercase tracking-widest mb-2">
            POSTAL COVERAGE ACROSS ALL DIVISIONS
          </p>
          <div class="flex flex-wrap gap-1.5">
            {BD_DIVISIONS.map((division) => (
              <span class="px-2 py-0.5 text-[10px] rounded bg-[#240508] text-gold-200/90 border border-gold-400/20 font-serif">
                {division}
              </span>
            ))}
          </div>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-3">
        <h3 class="text-xs font-cinzel font-bold text-gold-300 tracking-widest uppercase">
          EXPLORE
        </h3>
        <ul class="space-y-2 text-xs font-serif text-[#baa78d]">
          <li><a href="/shop" class="hover:text-gold-200 transition-colors">All Gifts</a></li>
          <li><a href="/shop?category=gift-boxes" class="hover:text-gold-200 transition-colors">Curated Hampers</a></li>
          <li><a href="/shop?category=customized" class="hover:text-gold-200 transition-colors">Personalized Keepsakes</a></li>
          <li><a href="/shop?category=handicrafts" class="hover:text-gold-200 transition-colors">Handicrafts & Nakshi</a></li>
          <li><a href="/shop?category=chocolates" class="hover:text-gold-200 transition-colors">Artisan Chocolates</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Care -->
      <div class="space-y-3">
        <h3 class="text-xs font-cinzel font-bold text-gold-300 tracking-widest uppercase">
          PARCEL SERVICES
        </h3>
        <ul class="space-y-2 text-xs font-serif text-[#baa78d]">
          <li><a href="/track-order" class="hover:text-gold-200 transition-colors">Track Your Parcel</a></li>
          <li><a href="/cart" class="hover:text-gold-200 transition-colors">Shopping Basket</a></li>
          <li><a href="/about" class="hover:text-gold-200 transition-colors">Our Postal Story</a></li>
          <li><a href="/contact" class="hover:text-gold-200 transition-colors">Inquiries & Support</a></li>
          <li><a href="/login" class="hover:text-gold-200 transition-colors">Patron Sign In</a></li>
          <li><a href="/admin" class="text-gold-400 hover:text-gold-300 font-medium flex items-center gap-1 font-sans">Admin Portal 🔐</a></li>
        </ul>
      </div>

      <!-- Col 4: Contact & Payment Info -->
      <div class="space-y-3">
        <h3 class="text-xs font-cinzel font-bold text-gold-300 tracking-widest uppercase">
          HEADQUARTERS
        </h3>
        <ul class="space-y-2 text-xs font-serif text-[#baa78d]">
          <li>
            <span class="text-gold-300">Hotline:</span>{' '}
            <a href={`tel:${BRAND.supportPhone}`} class="hover:text-gold-200 transition-colors">{BRAND.supportPhone}</a>
          </li>
          <li>
            <span class="text-gold-300">Dispatch:</span>{' '}
            <a href={`mailto:${BRAND.supportEmail}`} class="hover:text-gold-200 transition-colors">{BRAND.supportEmail}</a>
          </li>
          <li>
            <span class="text-gold-300">Registry:</span> {BRAND.address}
          </li>
        </ul>

        <div class="pt-2">
          <p class="text-[11px] font-cinzel font-semibold text-gold-300 uppercase tracking-widest mb-2">
            SECURE SETTLEMENT
          </p>
          <div class="flex items-center gap-2 text-xs font-sans">
            <span class="px-2 py-1 rounded bg-[#240508] border border-gold-400/20 font-medium text-pink-300">bKash</span>
            <span class="px-2 py-1 rounded bg-[#240508] border border-gold-400/20 font-medium text-amber-300">Nagad</span>
            <span class="px-2 py-1 rounded bg-[#240508] border border-gold-400/20 font-medium text-emerald-300">COD</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-6 border-t border-[#3b0b12] flex flex-col sm:flex-row items-center justify-between text-xs text-[#8c7761] gap-4 font-serif">
      <p>© {currentYear} {BRAND.name} ({BRAND.nameBn}). All rights reserved. Registered Postal Service.</p>
      <p class="font-bengali text-gold-300/80">{BRAND.tagline}</p>
    </div>
  </Container>
</footer>
