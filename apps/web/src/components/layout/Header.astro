---
import Container from '../ui/Container.astro';
import { BRAND } from '@meghpiyon/shared';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/shop', label: 'Collections' },
  { href: '/shop?category=gift-boxes', label: 'Curated Gifts' },
  { href: '/shop?category=customized', label: 'Custom Hampers' },
  { href: '/about', label: 'About' },
  { href: '/track-order', label: 'Track Order' },
];
---

<header class="sticky top-0 z-50">
  <!-- Announcement bar -->
  <div class="bg-ink-deep text-parchment/70">
    <Container size="lg">
      <div class="flex h-9 items-center justify-between gap-4 text-[10.5px] font-medium uppercase tracking-[0.16em]">
        <p class="flex items-center gap-2 truncate">
          <span class="inline-block h-1 w-1 shrink-0 rounded-full bg-gold-400"></span>
          <span class="truncate">Complimentary delivery on orders over {BRAND.currencySymbol}2,000</span>
        </p>
        <div class="hidden items-center gap-5 md:flex">
          <span class="text-parchment/50">Nationwide · 64 Districts</span>
          <span class="h-3 w-px bg-parchment/[0.15]"></span>
          <a href={`tel:${BRAND.supportPhone}`} class="link-underline text-parchment/80 transition-colors hover:text-gold-300">
            {BRAND.supportPhone}
          </a>
        </div>
        <p class="shrink-0 md:hidden">{BRAND.address}</p>
      </div>
    </Container>
  </div>

  <!-- Main navigation -->
  <div class="bg-ink/95 backdrop-blur-md">
    <Container size="lg">
      <div class="flex h-[76px] items-center justify-between gap-6">
        <!-- Brand lockup -->
        <a href="/" class="group flex shrink-0 items-center gap-3" aria-label={`${BRAND.name} — home`}>
          <span class="relative grid h-11 w-11 place-items-center rounded-full border border-gold-500/50 bg-gradient-to-br from-gold-200 via-gold-400 to-gold-700 shadow-[0_3px_12px_rgba(212,175,55,0.25)] transition-transform duration-300 group-hover:scale-105">
            <span class="font-bengali text-lg font-semibold text-ink-deep">ম</span>
            <span class="pointer-events-none absolute inset-[3px] rounded-full border border-dashed border-ink-deep/30"></span>
          </span>
          <span class="leading-none">
            <span class="flex items-start font-display text-[25px] font-semibold leading-none tracking-[0.01em]">
              <span class="text-gold-gradient">{BRAND.name}</span><span class="ml-0.5 text-[13px] font-medium text-gold-300/70">.{BRAND.domain.split('.')[1]}</span>
            </span>
            <span class="mt-1.5 hidden text-[9px] font-medium uppercase tracking-[0.3em] text-parchment/[0.45] sm:block">
              Bespoke Gifting · Est. 2024
            </span>
          </span>
        </a>

        <!-- Center links -->
        <nav class="hidden items-center gap-8 lg:flex" aria-label="Main navigation">
          {navLinks.map((link) => {
            const base = link.href.split('?')[0];
            const isActive = currentPath === base;
            return (
              <a
                href={link.href}
                class={`relative py-2 text-[11.5px] font-medium uppercase tracking-[0.16em] transition-colors duration-200 after:absolute after:-bottom-0.5 after:left-0 after:h-px after:bg-gold-400 after:transition-all after:duration-300 ${
                  isActive
                    ? 'text-gold-300 after:right-0'
                    : 'text-parchment/75 after:right-full hover:text-gold-200 hover:after:right-0'
                }`}
              >
                {link.label}
              </a>
            );
          })}
        </nav>

        <!-- Actions -->
        <div class="flex items-center gap-1.5 sm:gap-2.5">
          <a
            href="/shop"
            class="grid h-10 w-10 place-items-center rounded-full text-gold-300/90 transition-colors hover:bg-white/5 hover:text-gold-200"
            aria-label="Search the collection"
          >
            <svg class="h-[19px] w-[19px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </a>

          <a
            href="/login"
            class="hidden h-10 w-10 place-items-center rounded-full text-gold-300/90 transition-colors hover:bg-white/5 hover:text-gold-200 sm:grid"
            aria-label="Account"
          >
            <svg class="h-[19px] w-[19px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M16 19v-1a4 4 0 00-4-4H8a4 4 0 00-4 4v1M12 11a4 4 0 100-8 4 4 0 000 8z" />
            </svg>
          </a>

          <a
            href="/cart"
            class="ml-0.5 inline-flex items-center gap-2 rounded-full border border-gold-500/40 px-3 py-2 text-gold-200 transition-colors hover:border-gold-400 hover:bg-white/5"
            aria-label="Shopping bag"
          >
            <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M6 8h12l1 12H5L6 8zm3 0V6a3 3 0 016 0v2" />
            </svg>
            <span class="text-[11px] font-semibold uppercase tracking-[0.12em]">Bag</span>
            <span class="grid h-[18px] min-w-[18px] place-items-center rounded-full bg-gold-400 px-1 text-[10px] font-bold text-ink-deep">0</span>
          </a>

          <!-- Mobile menu -->
          <details class="relative lg:hidden">
            <summary class="grid h-10 w-10 cursor-pointer list-none place-items-center rounded-full text-gold-300/90 transition-colors hover:bg-white/5 hover:text-gold-200 [&::-webkit-details-marker]:hidden" aria-label="Open menu">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M4 7h16M4 12h16M4 17h16" />
              </svg>
            </summary>
            <div class="absolute right-0 mt-4 w-[268px] overflow-hidden rounded-[4px] border border-gold-700/30 bg-ink shadow-2xl">
              <div class="border-b border-parchment/10 px-5 py-4">
                <p class="font-display text-lg text-gold-200">{BRAND.name}</p>
                <p class="mt-0.5 font-bengali text-[11px] text-parchment/50">{BRAND.nameBn} — {BRAND.tagline}</p>
              </div>
              <nav class="py-2" aria-label="Mobile navigation">
                {navLinks.map((link) => (
                  <a
                    href={link.href}
                    class="block px-5 py-2.5 text-[11.5px] font-medium uppercase tracking-[0.16em] text-parchment/80 transition-colors hover:bg-white/5 hover:text-gold-200"
                  >
                    {link.label}
                  </a>
                ))}
              </nav>
              <div class="border-t border-parchment/10 px-5 py-4">
                <a href="/track-order" class="text-[11px] font-medium uppercase tracking-[0.16em] text-gold-300">
                  Track your parcel →
                </a>
              </div>
            </div>
          </details>
        </div>
      </div>
    </Container>
  </div>
  <div class="bg-ink-deep">
    <div class="h-[3px] w-full airmail-stripe opacity-60"></div>
  </div>
</header>