---
import Container from '../ui/Container.astro';
import { BRAND } from '@meghpiyon/shared';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/shop', label: 'Shop Gifts' },
  { href: '/about', label: 'Our Story' },
  { href: '/contact', label: 'Contact' },
  { href: '/track-order', label: 'Track Order' },
];
---

<header class="w-full bg-white border-b border-slate-200 sticky top-0 z-40">
  <!-- Top announcement bar -->
  <div class="bg-sky-600 text-white text-xs py-1.5 px-4 text-center">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-1">
      <p class="font-bengali font-medium tracking-wide">
        {BRAND.nameBn} — {BRAND.tagline}
      </p>
      <div class="hidden sm:flex items-center gap-4 text-sky-100">
        <span>Delivery Across All 64 Districts</span>
        <span>•</span>
        <a href={`tel:${BRAND.supportPhone}`} class="hover:text-white underline underline-offset-2">
          {BRAND.supportPhone}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation -->
  <Container size="lg">
    <div class="flex items-center justify-between h-16">
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-lg bg-sky-600 text-white flex items-center justify-center font-bold text-lg shadow-sm">
          ম
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-bold tracking-tight text-slate-900 leading-none">
            {BRAND.name}
          </span>
          <span class="text-[11px] font-medium text-sky-600 font-bengali leading-tight mt-0.5">
            {BRAND.nameBn}
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center gap-7">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`text-sm font-medium transition-none ${
                isActive
                  ? 'text-sky-600 border-b-2 border-sky-600 pb-0.5'
                  : 'text-slate-600 hover:text-sky-600'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Action CTAs -->
      <div class="flex items-center gap-3">
        <a
          href="/login"
          class="hidden sm:inline-flex text-sm font-medium text-slate-700 hover:text-sky-600 px-3 py-1.5"
        >
          Sign In
        </a>

        <a
          href="/cart"
          class="relative inline-flex items-center gap-1.5 px-3.5 py-2 bg-sky-50 text-sky-700 border border-sky-200 rounded-md text-sm font-medium hover:bg-sky-100"
          aria-label="Shopping Cart"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="hidden sm:inline">Cart</span>
          <span class="inline-flex items-center justify-center w-5 h-5 text-xs font-bold text-white bg-sky-600 rounded-full">
            0
          </span>
        </a>

        <!-- Mobile Menu details toggle (no JS required) -->
        <details class="md:hidden relative">
          <summary class="list-none p-2 text-slate-700 hover:text-sky-600 cursor-pointer rounded-md border border-slate-200" aria-label="Toggle navigation menu">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </summary>
          <div class="absolute right-0 mt-2 w-56 bg-white border border-slate-200 rounded-lg shadow-lg py-2 z-50">
            {navLinks.map((link) => (
              <a
                href={link.href}
                class="block px-4 py-2 text-sm text-slate-700 hover:bg-sky-50 hover:text-sky-700"
              >
                {link.label}
              </a>
            ))}
            <div class="border-t border-slate-100 my-1"></div>
            <a
              href="/login"
              class="block px-4 py-2 text-sm text-slate-700 hover:bg-sky-50 hover:text-sky-700"
            >
              Sign In / Register
            </a>
          </div>
        </details>
      </div>
    </div>
  </Container>
</header>
