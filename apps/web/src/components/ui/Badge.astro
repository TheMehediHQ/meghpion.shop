---
interface Props {
  variant?: 'sky' | 'slate' | 'green' | 'amber';
  className?: string;
}

const { variant = 'sky', className = '' } = Astro.props;

const variantStyles = {
  sky: 'bg-sky-50 text-sky-700 border-sky-200',
  slate: 'bg-slate-100 text-slate-700 border-slate-200',
  green: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  amber: 'bg-amber-50 text-amber-700 border-amber-200',
};
---

<span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium border ${variantStyles[variant]} ${className}`}>
  <slot />
</span>
