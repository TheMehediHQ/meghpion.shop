---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { BRAND } from '@meghpiyon/shared';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${BRAND.name} | ${BRAND.nameBn} - Bangladeshi Gift Items`,
  description = `${BRAND.name} - ${BRAND.tagline} Premium gift boxes, personalized gifts, handicrafts, and flowers delivered across Bangladesh.`,
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="bn-BD" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bn_BD" />
    <meta name="theme-color" content="#32090e" />

    <!-- Google Fonts for Bengali, Playfair Display, Cinzel & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Meta Pixel Code (Facebook Pixel) -->
    <script is:inline define:vars={{ pixelId: import.meta.env.PUBLIC_META_PIXEL_ID || '' }}>
      if (pixelId) {
        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      }
    </script>
    {import.meta.env.PUBLIC_META_PIXEL_ID && (
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          src={`https://www.facebook.com/tr?id=${import.meta.env.PUBLIC_META_PIXEL_ID}&ev=PageView&noscript=1`}
          alt=""
        />
      </noscript>
    )}
  </head>
  <body class="bg-white text-slate-900 font-sans min-h-screen flex flex-col antialiased">
    <Header currentPath={currentPath} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer />
  </body>
</html>
