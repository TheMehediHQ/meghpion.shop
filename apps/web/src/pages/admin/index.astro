---
import { AdminApp } from '../../components/admin/AdminApp';
import { BRAND } from '@meghpiyon/shared';
import '../../styles/global.css';

const title = `Admin Portal | ${BRAND.name}`;
const description = `Management dashboard for ${BRAND.name} (${BRAND.nameBn}) - Products, Orders, and Customers.`;
---

<!doctype html>
<html lang="bn-BD" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#3D0C11" />

    <!-- Google Fonts for Display, Bengali & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&family=Tiro+Bangla:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-parchment text-espresso font-sans min-h-screen antialiased">
    <AdminApp client:only="react" />
  </body>
</html>
