---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { CustomGiftBuilder } from '../components/builder/CustomGiftBuilder';
import { BRAND } from '@meghpiyon/shared';
---

<BaseLayout
  title={`Build Your Gift — নিজের উপহারের বাক্স সাজান | ${BRAND.name}`}
  description="পছন্দের উডেন বা ক্রাফট বক্স বেছে নিন, পছন্দের উপহার সামগ্রী যোগ করুন এবং বিনামূল্যে ক্যালিগ্রাফি চিরকুট ও ওয়াক্স সিলমোহরে মোড়ানো নিজস্ব কম্বো উপহার তৈরি করুন।"
>
  <!-- Atmospheric Page Header -->
  <section class="relative overflow-hidden bg-ink text-parchment">
    <div class="absolute inset-0 studio-backdrop opacity-70"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,rgba(212,175,55,0.15),transparent_65%)]"></div>

    <Container size="lg" className="relative py-14 sm:py-18 text-center">
      <span class="inline-flex items-center gap-2 font-bengali text-[12px] sm:text-[13px] font-medium tracking-wider text-gold-300">
        <span class="h-px w-6 sm:w-8 bg-gold-400/50"></span>
        কাস্টমাইজড উপহার সম্ভার · BUILD YOUR GIFT
        <span class="h-px w-6 sm:w-8 bg-gold-400/50"></span>
      </span>

      <h1 class="mt-4 font-tiro text-[32px] sm:text-[44px] md:text-[50px] font-normal leading-[1.3] text-parchment">
        নিজের ভালোবাসার উপহারের বাক্স সাজান
      </h1>

      <p class="mx-auto mt-3 max-w-2xl font-bengali text-[15px] sm:text-base leading-relaxed text-gold-200/90">
        বক্স নির্বাচন থেকে শুরু করে ভেতরের প্রতিটি উপহার, সাটিন ফিতা এবং আমাদের ক্যালিগ্রাফারের হাতে লেখা চিরকুট—সবকিছু সাজিয়ে নিন আপনার প্রিয়জনের ঠিক মনের মতো করে।
      </p>
    </Container>

    <!-- Airmail stripe divider -->
    <div class="h-[2px] w-full airmail-stripe"></div>
  </section>

  <!-- Interactive Builder Section -->
  <section class="bg-parchment-light pb-20">
    <CustomGiftBuilder client:load />
  </section>

  <!-- Trust Features Bar -->
  <section class="border-t border-parchment-line bg-parchment py-12">
    <Container size="lg">
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 text-center">
        <div class="rounded-[4px] border border-parchment-line bg-parchment-light p-5">
          <span class="text-2xl">🪵</span>
          <h2 class="mt-2 font-tiro text-base text-espresso">প্রিমিয়াম বক্স ও মোড়ক</h2>
          <p class="mt-1 font-bengali text-xs text-clay">খাঁটি কাঠ ও ক্রাফট পেপারের টেকসই স্মারক প্যাকেজিং।</p>
        </div>

        <div class="rounded-[4px] border border-parchment-line bg-parchment-light p-5">
          <span class="text-2xl">✒️</span>
          <h2 class="mt-2 font-tiro text-base text-espresso">ফ্রি ক্যালিগ্রাফি চিরকুট</h2>
          <p class="mt-1 font-bengali text-xs text-clay">প্রতিটি বক্সে থাকছে আমাদের নিজস্ব ক্যালিগ্রাফারের হাতে লেখা কার্ড।</p>
        </div>

        <div class="rounded-[4px] border border-parchment-line bg-parchment-light p-5">
          <span class="text-2xl">🕯️</span>
          <h2 class="mt-2 font-tiro text-base text-espresso">খাঁটি ওয়াক্স সিলমোহর</h2>
          <p class="mt-1 font-bengali text-xs text-clay">ঐতিহ্যবাহী গালা সিলমোহর ও প্রিমিয়াম সাটিন রিবনের বাঁধন।</p>
        </div>

        <div class="rounded-[4px] border border-parchment-line bg-parchment-light p-5">
          <span class="text-2xl">🚚</span>
          <h2 class="mt-2 font-tiro text-base text-espresso">সারাদেশে নিরাপদ ডেলিভারি</h2>
          <p class="mt-1 font-bengali text-xs text-clay">৬৪ জেলায় ট্র্যাকিং ও সর্বোচ্চ সুরক্ষা নিশ্চিত করে ডেলিভারি।</p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
