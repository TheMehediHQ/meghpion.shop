---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { BRAND } from '@meghpiyon/shared';

// Demo sample cart item
const sampleCartItem = {
  id: 'item-1',
  name: 'Shonar Bangla Artisan Gift Box',
  nameBn: 'সোনার বাংলা উপহার বক্স',
  price: 2200,
  quantity: 1,
  giftWrap: true,
  image: 'https://images.unsplash.com/photo-1543257580-7269da773bf5?w=200&auto=format&fit=crop&q=80',
};

const subtotal = sampleCartItem.price * sampleCartItem.quantity;
const giftWrapFee = sampleCartItem.giftWrap ? 100 : 0;
const deliveryFee = 80; // Dhaka delivery standard
const total = subtotal + giftWrapFee + deliveryFee;
---

<BaseLayout
  title={`Shopping Cart | ${BRAND.name}`}
  description="Review your selected gift items, add personalized notes, and proceed to checkout."
>
  <div class="py-12 bg-parchment-light">
    <Container size="lg">
      <h1 class="section-title mb-8">
        Your Gift Cart
      </h1>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Cart Items List -->
        <div class="lg:col-span-2 space-y-6">
          <div class="border border-parchment-line rounded-[4px] overflow-hidden divide-y divide-parchment-line">
            <div class="p-4 sm:p-6 flex flex-col sm:flex-row gap-4 sm:items-center">
              <img
                src={sampleCartItem.image}
                alt={sampleCartItem.name}
                class="w-20 h-20 object-cover rounded-[4px] bg-parchment-deep border border-parchment-line"
              />

              <div class="flex-1 space-y-1">
                <h2 class="text-base font-semibold text-espresso">
                  {sampleCartItem.name}
                </h2>
                <p class="text-xs text-gold-700 font-bengali">
                  {sampleCartItem.nameBn}
                </p>
                <p class="text-xs text-clay">
                  Premium Satin Ribbon & Gift Packaging Included
                </p>
              </div>

              <div class="flex sm:flex-col items-center sm:items-end justify-between gap-2">
                <span class="text-base font-bold text-espresso">
                  {BRAND.currencySymbol}{sampleCartItem.price}
                </span>
                <span class="text-xs text-clay">Qty: {sampleCartItem.quantity}</span>
              </div>
            </div>
          </div>

          <!-- Handwritten Note Reminder -->
          <div class="p-4 bg-gold-500/[0.06] border border-parchment-line rounded-[4px] flex items-start gap-3">
            <span class="text-gold-700 text-lg">✉️</span>
            <div class="text-xs text-espresso/[0.85]">
              <p class="font-semibold text-espresso">Complimentary Hand-Written Card</p>
              <p class="mt-0.5">
                You can write your personalized message on the next step during checkout.
              </p>
            </div>
          </div>

          <a href="/shop" class="inline-flex items-center text-xs font-semibold text-gold-700 hover:text-gold-700">
            &larr; Continue shopping for more gifts
          </a>
        </div>

        <!-- Order Summary Card -->
        <div class="bg-parchment border border-parchment-line rounded-[4px] p-6 h-fit space-y-6">
          <h2 class="text-lg font-bold text-espresso pb-3 border-b border-parchment-line">
            Order Summary
          </h2>

          <div class="space-y-3 text-sm">
            <div class="flex justify-between text-clay">
              <span>Subtotal</span>
              <span class="font-medium text-espresso">{BRAND.currencySymbol}{subtotal}</span>
            </div>
            <div class="flex justify-between text-clay">
              <span>Gift Wrapping</span>
              <span class="font-medium text-espresso">{BRAND.currencySymbol}{giftWrapFee}</span>
            </div>
            <div class="flex justify-between text-clay">
              <span>Estimated Delivery (Dhaka)</span>
              <span class="font-medium text-espresso">{BRAND.currencySymbol}{deliveryFee}</span>
            </div>
            <div class="pt-3 border-t border-parchment-line flex justify-between text-base font-bold text-espresso">
              <span>Total Amount</span>
              <span class="text-gold-700">{BRAND.currencySymbol}{total}</span>
            </div>
          </div>

          <a
            href="/checkout"
            class="btn-primary w-full py-3 text-sm font-bengali font-medium tracking-wide justify-center shadow"
          >
            অর্ডার করতে এগিয়ে যান
          </a>

          <div class="space-y-2 pt-2 text-[11px] text-clay border-t border-parchment-line">
            <p>✓ Secured checkout with bKash, Nagad, or COD</p>
            <p>✓ All parcels delivered in protective rigid boxes</p>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <script is:inline define:vars={{
    checkoutData: {
      value: total,
      currency: 'BDT',
      num_items: sampleCartItem.quantity
    }
  }}>
    const checkoutBtn = document.querySelector('a[href="/checkout"]');
    if (checkoutBtn) {
      checkoutBtn.addEventListener('click', () => {
        if (typeof window !== 'undefined' && typeof window.fbq === 'function') {
          window.fbq('track', 'InitiateCheckout', checkoutData);
        }
      });
    }
  </script>
</BaseLayout>
