---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { BRAND, BD_DIVISIONS } from '@meghpiyon/shared';
---

<BaseLayout
  title={`Checkout | ${BRAND.name}`}
  description="Complete your gift order with delivery details and payment preferences."
>
  <div class="py-12 bg-parchment-light">
    <Container size="lg">
      <h1 class="section-title mb-8">
        Checkout & Delivery
      </h1>

      <form class="grid grid-cols-1 lg:grid-cols-3 gap-12" action="/track-order" method="GET">
        <!-- Delivery and Recipient Information -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Step 1: Recipient Address -->
          <div class="border border-parchment-line rounded-[4px] p-6 space-y-5">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-white text-xs flex items-center justify-center font-bold">1</span>
              <h2 class="text-lg font-bold text-espresso font-bengali">প্রাপকের তথ্য ও ডেলিভারি ঠিকানা</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label for="fullName" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  প্রাপকের পুরো নাম *
                </label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  required
                  placeholder="যেমন: তানভীর আহমেদ"
                  class="input-field"
                />
              </div>

              <div class="space-y-1">
                <label for="phone" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  মোবাইল নম্বর *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="01700000000"
                  class="input-field"
                />
              </div>

              <div class="space-y-1">
                <label for="division" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  বিভাগ *
                </label>
                <select id="division" name="division" required class="input-field">
                  <option value="">বিভাগ নির্বাচন করুন</option>
                  {BD_DIVISIONS.map((division) => (
                    <option value={division}>{division}</option>
                  ))}
                </select>
              </div>

              <div class="space-y-1">
                <label for="district" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  জেলা ও এলাকা *
                </label>
                <input
                  type="text"
                  id="district"
                  name="district"
                  required
                  placeholder="যেমন: ঢাকা (ধানমন্ডি)"
                  class="input-field"
                />
              </div>

              <div class="sm:col-span-2 space-y-1">
                <label for="addressLine" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  সম্পূর্ণ ঠিকানা (বাসা/রোড/এলাকা) *
                </label>
                <input
                  type="text"
                  id="addressLine"
                  name="addressLine"
                  required
                  placeholder="বাড়ি নং, রোড নং, সেক্টর বা এলাকার বিস্তারিত ঠিকানা"
                  class="input-field"
                />
              </div>

              <div class="sm:col-span-2 space-y-1">
                <label for="deliveryNotes" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  ডেলিভারি নোট বা কাঙ্ক্ষিত তারিখ (ঐচ্ছিক)
                </label>
                <input
                  type="text"
                  id="deliveryNotes"
                  name="deliveryNotes"
                  placeholder="যেমন: শুক্রবার বিকেলে ডেলিভারি দিন, বা পৌঁছানোর আগে কল দিন"
                  class="input-field"
                />
              </div>
            </div>
          </div>

          <!-- Step 2: Handwritten Gift Card Note -->
          <div class="border border-parchment-line rounded-[4px] p-6 space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-white text-xs flex items-center justify-center font-bold">2</span>
              <h2 class="text-lg font-bold text-espresso font-bengali">চিরকুটের বার্তা (সম্পূর্ণ ফ্রি)</h2>
            </div>

            <p class="text-xs text-clay font-bengali">
              আমাদের ক্যালিগ্রাফার আপনার এই আন্তরিক বার্তাটি প্রিমিয়াম পার্চমেন্ট কার্ডে হাতে লিখে ওয়াক্স সিলমোহর দিয়ে বক্সে যুক্ত করবেন।
            </p>

            <textarea
              id="giftNote"
              name="giftNote"
              rows="3"
              class="input-field"
              placeholder="আপনার মনের সুন্দর বার্তাটি এখানে লিখুন... (বাংলা বা ইংরেজিতে লিখতে পারেন)"
            ></textarea>
          </div>

          <!-- Step 3: Payment Method -->
          <div class="border border-parchment-line rounded-[4px] p-6 space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-white text-xs flex items-center justify-center font-bold">3</span>
              <h2 class="text-lg font-bold text-espresso font-bengali">পেমেন্ট পদ্ধতি</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <label class="border border-gold-600/60 bg-parchment p-4 rounded-[4px] cursor-pointer flex flex-col items-start gap-1">
                <input type="radio" name="paymentMethod" value="cod" checked class="text-gold-700" />
                <span class="text-sm font-bold text-espresso mt-2 font-bengali">ক্যাশ অন ডেলিভারি</span>
                <span class="text-[11px] text-clay font-bengali">পণ্য হাতে পেয়ে মূল্য পরিশোধ</span>
              </label>

              <label class="border border-parchment-line p-4 rounded-[4px] cursor-pointer flex flex-col items-start gap-1 hover:border-gold-600/50">
                <input type="radio" name="paymentMethod" value="bkash" class="text-gold-700" />
                <span class="text-sm font-bold text-pink-600 mt-2 font-bengali">বিকাশ (bKash)</span>
                <span class="text-[11px] text-clay font-bengali">বিকাশ গেটওয়েতে পেমেন্ট</span>
              </label>

              <label class="border border-parchment-line p-4 rounded-[4px] cursor-pointer flex flex-col items-start gap-1 hover:border-gold-600/50">
                <input type="radio" name="paymentMethod" value="nagad" class="text-gold-700" />
                <span class="text-sm font-bold text-orange-600 mt-2 font-bengali">নগদ (Nagad)</span>
                <span class="text-[11px] text-clay font-bengali">নগদ গেটওয়েতে পেমেন্ট</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Right Summary Sidebar -->
        <div class="bg-parchment border border-parchment-line rounded-[4px] p-6 h-fit space-y-6">
          <h3 class="text-lg font-bold text-espresso pb-3 border-b border-parchment-line font-bengali">
            অর্ডার সামারি
          </h3>

          <div class="space-y-3 text-sm font-bengali">
            <div class="flex justify-between text-clay">
              <span id="labelItems">উপহার সামগ্রী</span>
              <span id="priceItems" class="font-medium text-espresso font-sans">{BRAND.currencySymbol}2,200</span>
            </div>
            <div class="flex justify-between text-clay">
              <span id="labelPackaging">লাক্সারি গিফট বক্স প্যাকেজিং</span>
              <span id="pricePackaging" class="font-medium text-espresso font-sans">{BRAND.currencySymbol}100</span>
            </div>
            <div class="flex justify-between text-clay">
              <span>ডেলিভারি চার্জ</span>
              <span class="font-medium text-espresso font-sans">{BRAND.currencySymbol}80</span>
            </div>
            <div class="pt-3 border-t border-parchment-line flex justify-between text-base font-bold text-espresso">
              <span>সর্বমোট প্রদেয়</span>
              <span id="priceTotal" class="text-gold-700 font-sans">{BRAND.currencySymbol}2,380</span>
            </div>
          </div>

          <button
            type="submit"
            class="btn-primary w-full py-3.5 text-base font-bengali font-medium tracking-wide justify-center shadow"
          >
            অর্ডার নিশ্চিত করুন
          </button>

          <p class="text-[11px] text-clay text-center leading-relaxed font-bengali">
            অর্ডার কনফার্ম করার মাধ্যমে আপনি {BRAND.name}-এর সেবার শর্তাবলী ও ডেলিভারি পলিসি মেনে নিচ্ছেন।
          </p>
        </div>
      </form>
    </Container>
  </div>

  <script is:inline>
    // Check if coming from Custom Hamper Builder
    try {
      const hamperDataStr = localStorage.getItem('meghpeon_custom_hamper');
      if (hamperDataStr) {
        const hamper = JSON.parse(hamperDataStr);
        if (hamper && hamper.type === 'custom_hamper') {
          // Pre-populate note
          const noteField = document.getElementById('giftNote');
          if (noteField && hamper.giftNote) {
            noteField.value = hamper.giftNote;
          }
          // Pre-populate recipient name
          const nameField = document.getElementById('fullName');
          if (nameField && hamper.recipientName) {
            nameField.value = hamper.recipientName;
          }

          // Update summary items
          const labelItems = document.getElementById('labelItems');
          const priceItems = document.getElementById('priceItems');
          const labelPackaging = document.getElementById('labelPackaging');
          const pricePackaging = document.getElementById('pricePackaging');
          const priceTotal = document.getElementById('priceTotal');

          if (labelPackaging && hamper.box) {
            labelPackaging.textContent = hamper.box.nameBn;
            if (pricePackaging) pricePackaging.textContent = '৳' + hamper.box.price;
          }

          if (labelItems && hamper.items) {
            const itemsSum = hamper.items.reduce((sum, itemEntry) => {
              return sum + (itemEntry.item ? itemEntry.item.price * itemEntry.quantity : 0);
            }, 0);
            const totalCount = hamper.items.reduce((sum, itemEntry) => sum + itemEntry.quantity, 0);
            labelItems.textContent = `উপহার সামগ্রী (${totalCount}টি আইটেম)`;
            if (priceItems) priceItems.textContent = '৳' + itemsSum;
          }

          if (priceTotal && hamper.totalPrice) {
            const deliveryFee = 80;
            const finalTotal = hamper.totalPrice + deliveryFee;
            priceTotal.textContent = '৳' + finalTotal.toLocaleString('en-US');
          }
        }
      }
    } catch (e) {
      console.warn('Hamper loader error', e);
    }

    const checkoutForm = document.querySelector('form');
    if (checkoutForm) {
      checkoutForm.addEventListener('submit', () => {
        if (typeof window !== 'undefined' && typeof window.fbq === 'function') {
          window.fbq('track', 'Purchase', {
            value: 2380,
            currency: 'BDT',
            content_type: 'product',
            num_items: 1,
            order_id: 'MP-' + Date.now().toString(36).toUpperCase()
          });
        }
      });
    }
  </script>
</BaseLayout>
