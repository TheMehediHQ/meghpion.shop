---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { BRAND, BD_DIVISIONS } from '@meghpiyon/shared';
---

<BaseLayout
  title={`Checkout | ${BRAND.name}`}
  description="Complete your gift order with delivery details and payment preferences."
>
  <div class="py-12 bg-parchment-light">
    <Container size="lg">
      <h1 class="section-title mb-8">
        Checkout & Delivery
      </h1>

      <form id="checkoutForm" class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Delivery and Recipient Information -->
        <div class="lg:col-span-2 space-y-8">
          <!-- Step 1: Recipient Address -->
          <div class="border border-parchment-line rounded-[4px] p-6 space-y-5">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-white text-xs flex items-center justify-center font-bold">1</span>
              <h2 class="text-lg font-bold text-espresso font-bengali">প্রাপকের তথ্য ও ডেলিভারি ঠিকানা</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label for="fullName" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  প্রাপকের পুরো নাম *
                </label>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  required
                  placeholder="যেমন: তানভীর আহমেদ"
                  class="input-field"
                />
              </div>

              <div class="space-y-1">
                <label for="phone" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  মোবাইল নম্বর *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  placeholder="01700000000"
                  class="input-field"
                />
              </div>

              <div class="space-y-1">
                <label for="division" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  বিভাগ *
                </label>
                <select id="division" name="division" required class="input-field">
                  <option value="">বিভাগ নির্বাচন করুন</option>
                  {BD_DIVISIONS.map((division) => (
                    <option value={division}>{division}</option>
                  ))}
                </select>
              </div>

              <div class="space-y-1">
                <label for="district" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  জেলা ও এলাকা *
                </label>
                <input
                  type="text"
                  id="district"
                  name="district"
                  required
                  placeholder="যেমন: ঢাকা (ধানমন্ডি)"
                  class="input-field"
                />
              </div>

              <div class="sm:col-span-2 space-y-1">
                <label for="addressLine" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  সম্পূর্ণ ঠিকানা (বাসা/রোড/এলাকা) *
                </label>
                <input
                  type="text"
                  id="addressLine"
                  name="addressLine"
                  required
                  placeholder="বাড়ি নং, রোড নং, সেক্টর বা এলাকার বিস্তারিত ঠিকানা"
                  class="input-field"
                />
              </div>

              <div class="sm:col-span-2 space-y-1">
                <label for="deliveryNotes" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                  ডেলিভারি নোট বা কাঙ্ক্ষিত তারিখ (ঐচ্ছিক)
                </label>
                <input
                  type="text"
                  id="deliveryNotes"
                  name="deliveryNotes"
                  placeholder="যেমন: শুক্রবার বিকেলে ডেলিভারি দিন, বা পৌঁছানোর আগে কল দিন"
                  class="input-field"
                />
              </div>
            </div>
          </div>

          <!-- Step 2: Handwritten Gift Card Note -->
          <div class="border border-parchment-line rounded-[4px] p-6 space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-white text-xs flex items-center justify-center font-bold">2</span>
              <h2 class="text-lg font-bold text-espresso font-bengali">চিরকুটের বার্তা (সম্পূর্ণ ফ্রি)</h2>
            </div>

            <p class="text-xs text-clay font-bengali">
              আমাদের ক্যালিগ্রাফার আপনার এই আন্তরিক বার্তাটি প্রিমিয়াম পার্চমেন্ট কার্ডে হাতে লিখে ওয়াক্স সিলমোহর দিয়ে বক্সে যুক্ত করবেন।
            </p>

            <textarea
              id="giftNote"
              name="giftNote"
              rows="3"
              class="input-field"
              placeholder="আপনার মনের সুন্দর বার্তাটি এখানে লিখুন... (বাংলা বা ইংরেজিতে লিখতে পারেন)"
            ></textarea>
          </div>

          <!-- Step 3: Payment Method -->
          <div class="border border-parchment-line rounded-[4px] p-6 space-y-4">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-ink text-white text-xs flex items-center justify-center font-bold">3</span>
              <h2 class="text-lg font-bold text-espresso font-bengali">পেমেন্ট পদ্ধতি</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <label class="border border-gold-600/60 bg-parchment p-4 rounded-[4px] cursor-pointer flex flex-col items-start gap-1">
                <input type="radio" name="paymentMethod" value="cod" checked class="text-gold-700" />
                <span class="text-sm font-bold text-espresso mt-2 font-bengali">ক্যাশ অন ডেলিভারি</span>
                <span class="text-[11px] text-clay font-bengali">পণ্য হাতে পেয়ে মূল্য পরিশোধ</span>
              </label>

              <label class="border border-parchment-line p-4 rounded-[4px] cursor-pointer flex flex-col items-start gap-1 hover:border-gold-600/50">
                <input type="radio" name="paymentMethod" value="bkash" class="text-gold-700" />
                <span class="text-sm font-bold text-pink-600 mt-2 font-bengali">বিকাশ (bKash)</span>
                <span class="text-[11px] text-clay font-bengali">ম্যানুয়াল সেন্ড মানি (TrxID)</span>
              </label>

              <label class="border border-parchment-line p-4 rounded-[4px] cursor-pointer flex flex-col items-start gap-1 hover:border-gold-600/50">
                <input type="radio" name="paymentMethod" value="nagad" class="text-gold-700" />
                <span class="text-sm font-bold text-orange-600 mt-2 font-bengali">নগদ (Nagad)</span>
                <span class="text-[11px] text-clay font-bengali">ম্যানুয়াল সেন্ড মানি (TrxID)</span>
              </label>
            </div>

            <!-- Manual bKash / Nagad Send Money Instructions -->
            <div id="manualPaymentBox" class="hidden rounded-[4px] border border-gold-600/40 bg-parchment p-4 space-y-4">
              <div class="text-xs text-espresso font-bengali space-y-1">
                <p class="font-semibold">
                  নিচের পার্সোনাল নম্বরে <span id="manualMethodLabel" class="text-gold-700">বিকাশ</span> থেকে Send Money করুন:
                </p>
                <p class="font-sans text-sm font-bold text-espresso tracking-wide">
                  {BRAND.supportPhone} <span class="text-[11px] font-normal text-clay font-bengali">(Personal)</span>
                </p>
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="space-y-1">
                  <label for="paymentSender" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                    যে নম্বর থেকে পাঠিয়েছেন *
                  </label>
                  <input
                    type="tel"
                    id="paymentSender"
                    name="paymentSender"
                    placeholder="01700000000"
                    class="input-field"
                  />
                </div>
                <div class="space-y-1">
                  <label for="paymentTrxId" class="block text-xs font-semibold text-espresso/[0.85] font-bengali">
                    Transaction ID (TrxID) *
                  </label>
                  <input
                    type="text"
                    id="paymentTrxId"
                    name="paymentTrxId"
                    placeholder="যেমন: 9K7A2B1C3D"
                    class="input-field uppercase"
                  />
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Summary Sidebar -->
        <div class="bg-parchment border border-parchment-line rounded-[4px] p-6 h-fit space-y-6">
          <h3 class="text-lg font-bold text-espresso pb-3 border-b border-parchment-line font-bengali">
            অর্ডার সামারি
          </h3>

          <div id="emptyCheckoutNotice" class="hidden rounded-[4px] border border-amber-300 bg-amber-50 p-4 text-xs text-espresso font-bengali space-y-2">
            <p class="font-semibold">আপনার ব্যাগে কোনো উপহার যোগ করা নেই।</p>
            <div class="flex gap-3">
              <a href="/shop" class="text-gold-700 underline font-semibold">উপহার দেখুন</a>
              <a href="/build-gift" class="text-gold-700 underline font-semibold">হ্যাম্পার সাজান</a>
            </div>
          </div>

          <div id="summaryBreakdown" class="space-y-3 text-sm font-bengali">
            <div class="flex justify-between text-clay">
              <span id="labelItems">উপহার সামগ্রী</span>
              <span id="priceItems" class="font-medium text-espresso font-sans">{BRAND.currencySymbol}0</span>
            </div>
            <div class="flex justify-between text-clay">
              <span id="labelPackaging">লাক্সারি গিফট বক্স প্যাকেজিং</span>
              <span id="pricePackaging" class="font-medium text-espresso font-sans">{BRAND.currencySymbol}0</span>
            </div>
            <div class="flex justify-between text-clay">
              <span>ডেলিভারি চার্জ</span>
              <span class="font-medium text-espresso font-sans">{BRAND.currencySymbol}80</span>
            </div>
            <div class="pt-3 border-t border-parchment-line flex justify-between text-base font-bold text-espresso">
              <span>সর্বমোট প্রদেয়</span>
              <span id="priceTotal" class="text-gold-700 font-sans">{BRAND.currencySymbol}0</span>
            </div>
          </div>

          <button
            type="submit"
            id="placeOrderBtn"
            class="btn-primary w-full py-3.5 text-base font-bengali font-medium tracking-wide justify-center shadow"
          >
            অর্ডার নিশ্চিত করুন
          </button>

          <p class="text-[11px] text-clay text-center leading-relaxed font-bengali">
            অর্ডার কনফার্ম করার মাধ্যমে আপনি {BRAND.name}-এর সেবার শর্তাবলী ও ডেলিভারি পলিসি মেনে নিচ্ছেন।
          </p>
        </div>
      </form>
    </Container>
  </div>

  <script>
    import { submitOrder } from '../lib/api';
    import { getCart, clearCart } from '../lib/cart';

    const DELIVERY_FEE = 80;
    const STANDARD_GIFT_WRAP_FEE = 100;

    const labelItems = document.getElementById('labelItems');
    const priceItems = document.getElementById('priceItems');
    const labelPackaging = document.getElementById('labelPackaging');
    const pricePackaging = document.getElementById('pricePackaging');
    const priceTotal = document.getElementById('priceTotal');
    const emptyNotice = document.getElementById('emptyCheckoutNotice');
    const placeOrderBtn = document.getElementById('placeOrderBtn') as HTMLButtonElement | null;
    const noteField = document.getElementById('giftNote') as HTMLTextAreaElement | null;
    const nameField = document.getElementById('fullName') as HTMLInputElement | null;

    function getActiveCheckoutSource() {
      const cartItems = getCart();
      if (cartItems.length > 0) {
        return { source: 'cart' as const, cartItems, hamper: null };
      }
      try {
        const hamperDataStr = localStorage.getItem('meghpeon_custom_hamper');
        if (hamperDataStr) {
          const hamper = JSON.parse(hamperDataStr);
          if (hamper && hamper.type === 'custom_hamper' && Array.isArray(hamper.items) && hamper.items.length > 0) {
            return { source: 'hamper' as const, cartItems: [], hamper };
          }
        }
      } catch (e) {
        console.warn('Hamper loader error', e);
      }
      return { source: 'empty' as const, cartItems: [], hamper: null };
    }

    const initial = getActiveCheckoutSource();

    if (initial.source === 'hamper' && initial.hamper) {
      const hamper = initial.hamper;
      if (noteField && hamper.giftNote) noteField.value = hamper.giftNote;
      if (nameField && hamper.recipientName) nameField.value = hamper.recipientName;

      if (labelPackaging && hamper.box) {
        labelPackaging.textContent = hamper.box.nameBn;
        if (pricePackaging) pricePackaging.textContent = '৳' + hamper.box.price;
      }

      const itemsSum = hamper.items.reduce((sum: number, itemEntry: any) => {
        return sum + (itemEntry.item ? itemEntry.item.price * itemEntry.quantity : 0);
      }, 0);
      const totalCount = hamper.items.reduce((sum: number, itemEntry: any) => sum + itemEntry.quantity, 0);
      if (labelItems) labelItems.textContent = `উপহার সামগ্রী (${totalCount}টি আইটেম)`;
      if (priceItems) priceItems.textContent = '৳' + itemsSum.toLocaleString('en-US');

      const finalTotal = (hamper.totalPrice || itemsSum + (hamper.box?.price || 0)) + DELIVERY_FEE;
      if (priceTotal) priceTotal.textContent = '৳' + finalTotal.toLocaleString('en-US');
    } else if (initial.source === 'cart') {
      const items = initial.cartItems;
      const totalCount = items.reduce((sum, item) => sum + item.quantity, 0);
      const itemsSum = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
      const firstNote = items.find((i) => i.giftMessage)?.giftMessage;
      if (noteField && firstNote && !noteField.value) {
        noteField.value = firstNote;
      }

      if (labelItems) labelItems.textContent = `উপহার সামগ্রী (${totalCount}টি আইটেম)`;
      if (priceItems) priceItems.textContent = '৳' + itemsSum.toLocaleString('en-US');
      if (pricePackaging) pricePackaging.textContent = '৳' + STANDARD_GIFT_WRAP_FEE;
      if (priceTotal) priceTotal.textContent = '৳' + (itemsSum + STANDARD_GIFT_WRAP_FEE + DELIVERY_FEE).toLocaleString('en-US');
    } else {
      emptyNotice?.classList.remove('hidden');
      if (placeOrderBtn) {
        placeOrderBtn.disabled = true;
        placeOrderBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
    }

    const checkoutForm = document.getElementById('checkoutForm') as HTMLFormElement | null;
    const manualPaymentBox = document.getElementById('manualPaymentBox');
    const manualMethodLabel = document.getElementById('manualMethodLabel');
    const paymentSenderInput = document.getElementById('paymentSender') as HTMLInputElement | null;
    const paymentTrxIdInput = document.getElementById('paymentTrxId') as HTMLInputElement | null;

    document.querySelectorAll('input[name="paymentMethod"]').forEach((radio) => {
      radio.addEventListener('change', (e) => {
        const val = (e.target as HTMLInputElement).value;
        const isManual = val === 'bkash' || val === 'nagad';
        manualPaymentBox?.classList.toggle('hidden', !isManual);
        if (manualMethodLabel) {
          manualMethodLabel.textContent = val === 'bkash' ? 'বিকাশ (bKash)' : 'নগদ (Nagad)';
        }
        if (paymentSenderInput) paymentSenderInput.required = isManual;
        if (paymentTrxIdInput) paymentTrxIdInput.required = isManual;
      });
    });

    if (checkoutForm) {
      checkoutForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const active = getActiveCheckoutSource();
        if (active.source === 'empty') {
          alert('অনুগ্রহ করে প্রথমে শপ থেকে অন্তত একটি উপহার ব্যাগে যোগ করুন।');
          return;
        }

        if (!placeOrderBtn) return;
        const originalText = placeOrderBtn.innerHTML;
        placeOrderBtn.disabled = true;
        placeOrderBtn.innerHTML = '<span class="inline-block animate-spin mr-2">⏳</span>অর্ডার প্রসেসিং হচ্ছে...';

        try {
          const formData = new FormData(checkoutForm);
          const fullName = String(formData.get('fullName') || '').trim();
          const phone = String(formData.get('phone') || '').trim();
          const division = String(formData.get('division') || 'Dhaka');
          const district = String(formData.get('district') || '').trim();
          const addressLine = String(formData.get('addressLine') || '').trim();
          const rawDeliveryNotes = String(formData.get('deliveryNotes') || '').trim();
          const giftNote = String(formData.get('giftNote') || '').trim();
          const paymentMethod = String(formData.get('paymentMethod') || 'cod');
          const paymentSender = String(formData.get('paymentSender') || '').trim();
          const paymentTrxId = String(formData.get('paymentTrxId') || '').trim();

          let deliveryNotes = rawDeliveryNotes;
          if (paymentMethod === 'bkash' || paymentMethod === 'nagad') {
            const paymentInfo = `[${paymentMethod.toUpperCase()} Sender: ${paymentSender}, TrxID: ${paymentTrxId}]`;
            deliveryNotes = (deliveryNotes ? `${deliveryNotes} | ${paymentInfo}` : paymentInfo).slice(0, 250);
          }

          let orderItems: any[] = [];
          let giftWrap = false;

          if (active.source === 'cart') {
            giftWrap = true;
            orderItems = active.cartItems.map((item) => ({
              productId: item.productId,
              name: item.nameBn || item.name,
              price: Number(item.price),
              quantity: Number(item.quantity) || 1,
              image: item.image,
              giftWrap: true,
              giftMessage: giftNote || item.giftMessage || undefined,
            }));
          } else if (active.source === 'hamper' && active.hamper) {
            const hamper = active.hamper;
            giftWrap = false; // box is included as a line item
            orderItems = hamper.items.map((itemEntry: any) => ({
              productId: itemEntry.item?.id || 'custom-item',
              name: itemEntry.item?.nameBn || itemEntry.item?.name || 'কাস্টম উপহার আইটেম',
              price: Number(itemEntry.item?.price) || 500,
              quantity: Number(itemEntry.quantity) || 1,
              giftWrap: true,
              giftMessage: giftNote || undefined,
            }));
            if (hamper.box) {
              orderItems.unshift({
                productId: hamper.box.id,
                name: hamper.box.nameBn,
                price: Number(hamper.box.price),
                quantity: 1,
                giftWrap: true,
              });
            }
          }

          const orderPayload = {
            items: orderItems,
            shippingAddress: {
              fullName,
              phone,
              division,
              district,
              addressLine,
              deliveryNotes: deliveryNotes || undefined,
            },
            paymentMethod,
            giftWrap,
            giftNote: giftNote || undefined,
          };

          const order = await submitOrder(orderPayload);
          const orderNumber = order?.orderNumber;
          if (!orderNumber) {
            throw new Error('অর্ডার নম্বর পাওয়া যায়নি।');
          }

          clearCart();
          localStorage.removeItem('meghpeon_custom_hamper');

          window.location.href = `/track-order?order=${encodeURIComponent(orderNumber)}`;
        } catch (err: any) {
          alert('ত্রুটি: ' + (err?.message || 'অর্ডার করতে সমস্যা হয়েছে।'));
          placeOrderBtn.disabled = false;
          placeOrderBtn.innerHTML = originalText;
        }
      });
    }
  </script>
</BaseLayout>
