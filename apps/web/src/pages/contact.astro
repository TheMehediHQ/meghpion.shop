---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Badge from '../components/ui/Badge.astro';
import { BRAND } from '@meghpiyon/shared';
---

<BaseLayout
  title={`Contact & Support | ${BRAND.name}`}
  description="Get in touch with the Meghpiyon gift concierge team for inquiries, custom hamper requests, and order assistance."
>
  <div class="py-16 bg-white">
    <Container size="lg">
      <div class="max-w-2xl mx-auto text-center mb-12 space-y-3">
        <Badge variant="sky">We Are Here To Help</Badge>
        <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight">
          Contact Our Gift Concierge
        </h1>
        <p class="text-sm text-slate-600">
          Have a question regarding custom gift boxes, delivery timelines, or corporate collaborations? Send us a message and our team will respond promptly.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Contact Information Cards -->
        <div class="space-y-6">
          <div class="border border-slate-200 rounded-xl p-6 bg-slate-50 space-y-4">
            <h2 class="text-base font-bold text-slate-900">Direct Inquiries</h2>

            <div class="space-y-3 text-xs text-slate-600">
              <div>
                <p class="font-semibold text-slate-900">Customer Helpline</p>
                <a href={`tel:${BRAND.supportPhone}`} class="text-sky-600 font-medium text-sm hover:underline">
                  {BRAND.supportPhone}
                </a>
                <p class="text-[11px] text-slate-500 mt-0.5">Everyday 9:00 AM – 10:00 PM</p>
              </div>

              <div>
                <p class="font-semibold text-slate-900">Official Email</p>
                <a href={`mailto:${BRAND.supportEmail}`} class="text-sky-600 font-medium hover:underline">
                  {BRAND.supportEmail}
                </a>
              </div>

              <div>
                <p class="font-semibold text-slate-900">Studio & Workshop</p>
                <p class="text-slate-700">{BRAND.address}</p>
                <p class="text-[11px] text-slate-500 mt-0.5">Visits by appointment for custom wedding hampers</p>
              </div>
            </div>
          </div>

          <div class="border border-sky-100 rounded-xl p-5 bg-sky-50 text-xs text-slate-700 space-y-2">
            <p class="font-bold text-sky-900">Corporate & Bulk Inquiries</p>
            <p>
              We provide customized corporate gift boxes with branded laser engraving, company ribbon colors, and bulk division-wise shipping.
            </p>
          </div>
        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-2 border border-slate-200 rounded-xl p-6 sm:p-8 bg-white shadow-sm">
          <form class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label for="name" class="block text-xs font-semibold text-slate-700">
                  Your Full Name *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="e.g. Nusrat Jahan"
                  class="input-field"
                />
              </div>

              <div class="space-y-1">
                <label for="email" class="block text-xs font-semibold text-slate-700">
                  Email Address *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="name@example.com"
                  class="input-field"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1">
                <label for="phone" class="block text-xs font-semibold text-slate-700">
                  Phone Number
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="01700000000"
                  class="input-field"
                />
              </div>

              <div class="space-y-1">
                <label for="subject" class="block text-xs font-semibold text-slate-700">
                  Subject *
                </label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  required
                  placeholder="e.g. Custom Birthday Box Inquiry"
                  class="input-field"
                />
              </div>
            </div>

            <div class="space-y-1">
              <label for="message" class="block text-xs font-semibold text-slate-700">
                Your Message *
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="Tell us about the occasion, preferred items, or delivery date..."
                class="input-field"
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full sm:w-auto px-6 py-2.5">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </Container>
  </div>
</BaseLayout>
