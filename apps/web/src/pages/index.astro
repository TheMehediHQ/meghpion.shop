---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProductCard from '../components/ui/ProductCard.astro';
import Stars from '../components/ui/Stars.astro';
import CategoryIcon from '../components/ui/CategoryIcon.astro';
import WaxSeal from '../components/hero-props/WaxSeal.astro';
import { BRAND, PRODUCT_CATEGORIES } from '@meghpiyon/shared';

const benefits = [
  {
    title: 'Complimentary Delivery',
    text: `Free across Bangladesh on orders over ${BRAND.currencySymbol}2,000`,
    icon: 'M3 7h11v8H3zM14 10h4l3 3v2h-7zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm11 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3z',
  },
  {
    title: 'Hand-Tied & Wax-Sealed',
    text: 'Every parcel finished by hand in our Dhaka atelier',
    icon: 'M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4zm-2.5 8.5L12 14l2.5-2.5',
  },
  {
    title: 'Delivered in 64 Districts',
    text: 'Tracked courier with same-day Dhaka dispatch',
    icon: 'M12 21s7-5.5 7-11a7 7 0 10-14 0c0 5.5 7 11 7 11z',
  },
  {
    title: '7-Day Easy Exchange',
    text: 'Changed your mind? We will make it right',
    icon: 'M4 12a8 8 0 0113.7-5.7L20 8M20 4v4h-4M20 12a8 8 0 01-13.7 5.7L4 16m0 4v-4h4',
  },
];

const categoryMeta: Record<string, { count: string; blurb: string }> = {
  'gift-boxes': { count: '48 gifts', blurb: 'Layered keepsake boxes' },
  customized: { count: '26 gifts', blurb: 'Engraved & personalised' },
  handicrafts: { count: '34 gifts', blurb: 'Nakshi kantha & pottery' },
  chocolates: { count: '18 gifts', blurb: 'Small-batch confections' },
  flowers: { count: '22 gifts', blurb: 'Fresh & pressed blooms' },
  jewelry: { count: '15 gifts', blurb: 'Artisan brass & silver' },
  'greeting-cards': { count: '40 designs', blurb: 'Letterpress & calligraphy' },
};

const featured = [
  {
    name: 'Shonar Bangla Artisan Gift Box',
    nameBn: 'সোনার বাংলা উপহার বক্স',
    slug: 'shonar-bangla-artisan-gift-box',
    price: 2450,
    discountPrice: 2200,
    category: 'Curated Gift Box',
    image: 'https://images.unsplash.com/photo-1549465220-1a8b9238cd48?w=800&auto=format&fit=crop&q=80',
    tags: ['Best Seller'],
    rating: 4.9,
    reviewCount: 128,
  },
  {
    name: 'Nakshi Kantha Embroidered Diary & Pen',
    nameBn: 'নকশিকাঁথা ডায়েরি ও কলম',
    slug: 'nakshi-kantha-diary-pen',
    price: 1250,
    category: 'Handicrafts',
    image: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=800&auto=format&fit=crop&q=80',
    tags: ['Artisan Made'],
    rating: 4.8,
    reviewCount: 64,
  },
  {
    name: 'Artisanal Chocolates & Dry Fruits Hamper',
    nameBn: 'চকলেট ও ড্রাই ফ্রুটস হ্যাম্পার',
    slug: 'artisanal-chocolates-dry-fruits',
    price: 1850,
    category: 'Gourmet Hamper',
    image: 'https://images.unsplash.com/photo-1511381939415-e44015466834?w=800&auto=format&fit=crop&q=80',
    tags: ['Gourmet'],
    rating: 5,
    reviewCount: 91,
  },
  {
    name: 'Monsoon Jasmine & Rose Floral Box',
    nameBn: 'গোলাপ ও বেলি ফুলের বক্স',
    slug: 'monsoon-jasmine-rose-box',
    price: 1400,
    category: 'Fresh Flowers',
    image: 'https://images.unsplash.com/photo-1561181286-d3fee7d55364?w=800&auto=format&fit=crop&q=80',
    tags: ['Seasonal'],
    rating: 4.9,
    reviewCount: 57,
  },
];

const stats = [
  { value: '12,000+', label: 'Gifts delivered' },
  { value: '64', label: 'Districts served' },
  { value: '40+', label: 'Artisan partners' },
  { value: '4.9', label: 'Average rating' },
];

const testimonials = [
  {
    quote:
      'The hamper arrived wrapped in parchment with a wax seal and a handwritten note. My mother kept the box on her shelf — it felt like receiving a letter, not a parcel.',
    name: 'Nusrat Jahan',
    city: 'Dhaka',
    occasion: 'Anniversary Hamper',
  },
  {
    quote:
      'I ordered from Chattogram at 11am and it reached my sister in Sylhet the next morning, perfectly intact. The presentation is genuinely boutique quality.',
    name: 'Tanvir Ahmed',
    city: 'Chattogram',
    occasion: 'Birthday Hamper',
  },
  {
    quote:
      'The nakshi kantha journal is beautiful — you can feel the hand embroidery. Beautifully packed, fairly priced, and the team answered every question.',
    name: 'Farhana Islam',
    city: 'Sylhet',
    occasion: 'Personalised Keepsake',
  },
];
---

<BaseLayout
  title={`${BRAND.name} — Bespoke Gift Hampers & Heirloom Keepsakes`}
  description={`${BRAND.name} crafts hand-tied gift hampers, vintage postal keepsakes and artisanal treasures, delivered across all 64 districts of Bangladesh.`}
>
  <!-- ============================= HERO ============================= -->
  <section class="relative min-h-[580px] sm:min-h-[640px] md:min-h-[720px] lg:min-h-[780px] xl:min-h-[840px] flex items-center justify-center overflow-hidden bg-[#240508] text-parchment border-b border-[#E5DEC9]">
    <!-- Atmospheric Vintage Photo Flatlay Background with Dried Flowers, Brass Scale, Hampers & Compass -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero-vintage-bg.jpg"
        alt="Meghpiyon — Handcrafted Sentiments, Delivered with Love"
        fetchpriority="high"
        width="2752"
        height="1536"
        class="w-full h-full object-cover object-center"
      />
    </div>

    <!-- Center Typography & Button on the Parchment Paper -->
    <div class="relative z-10 w-full max-w-[340px] sm:max-w-[420px] md:max-w-[460px] lg:max-w-[490px] px-4 mx-auto flex flex-col items-center justify-center text-center">
      <h1 class="font-tiro font-normal sm:font-medium text-[#2B1512] text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[1.45] select-none text-balance">
        ভালোবাসা<br />
        পৌঁছে যাক,<br />
        উপহারে...
      </h1>

      <div class="mt-6 sm:mt-7 md:mt-8">
        <a
          href="/shop"
          class="group relative inline-flex items-center justify-center px-8 py-3 sm:px-9 sm:py-3.5 bg-[#B29258] hover:bg-[#9C7E48] text-[#F6F2EA] font-tiro text-base sm:text-lg tracking-normal rounded-[3px] shadow-[0_4px_16px_rgba(36,20,16,0.3)] transition-all duration-200 transform hover:-translate-y-0.5 border border-[#8F6F3A]"
        >
          <!-- Subtle inner border flourish -->
          <span class="pointer-events-none absolute inset-[3px] rounded-[2px] border border-[#F6F2EA]/40 group-hover:border-[#F6F2EA]/60 transition-colors"></span>
          <span class="mr-2.5 text-[11px] text-[#F6F2EA]/75 select-none font-serif">❖</span>
          <span class="font-medium pt-0.5">উপহার দেখুন</span>
          <span class="ml-2.5 text-[11px] text-[#F6F2EA]/75 select-none font-serif">❖</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================= BENEFITS ============================= -->
  <section class="border-b border-[#E5DEC9] bg-[#F6F2EA]">
    <Container size="lg">
      <div class="grid grid-cols-1 gap-6 py-9 sm:grid-cols-2 lg:grid-cols-4">
        {benefits.map((benefit) => (
          <div key={benefit.title} class="flex items-start gap-3.5">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-gold-600/25 bg-gold-500/[0.07] text-gold-700">
              <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d={benefit.icon} />
              </svg>
            </span>
            <div>
              <p class="text-[12.5px] font-semibold text-espresso">{benefit.title}</p>
              <p class="mt-0.5 text-[11.5px] leading-relaxed text-clay">{benefit.text}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============================= CATEGORIES ============================= -->
  <section class="bg-parchment py-20">
    <Container size="lg">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading
          eyebrow="The Collections"
          title="Shop by Occasion"
          lead="Seven considered collections, each finished by hand — from layered keepsake boxes to pressed-flower keepsakes."
        />
        <a href="/shop" class="btn-outline-dark shrink-0">
          View All Gifts
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 12h15m-6-6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-4">
        {PRODUCT_CATEGORIES.map((cat) => {
          const meta = categoryMeta[cat.id] ?? { count: '', blurb: '' };
          return (
            <a
              href={`/shop?category=${cat.id}`}
              class="group relative overflow-hidden rounded-[4px] border border-parchment-line bg-parchment-light p-6 transition-all duration-300 hover:-translate-y-1 hover:border-gold-500/60 hover:shadow-[0_24px_40px_-30px_rgba(43,27,23,0.5)]"
            >
              <span class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gold-500/50 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></span>

              <span class="grid h-14 w-14 place-items-center rounded-full border border-gold-600/25 bg-gold-500/[0.07] text-gold-700 transition-colors duration-300 group-hover:bg-gold-500/15">
                <CategoryIcon id={cat.id} />
              </span>

              <p class="mt-5 text-[9.5px] font-semibold uppercase tracking-[0.2em] text-gold-700">{meta.count}</p>
              <h3 class="mt-1.5 font-display text-[19px] leading-snug text-espresso">{cat.nameEn}</h3>
              <p class="mt-0.5 font-bengali text-[11.5px] text-clay">{cat.nameBn}</p>
              <p class="mt-3 text-[11.5px] leading-relaxed text-clay/80">{meta.blurb}</p>
            </a>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- ============================= FEATURED ============================= -->
  <section class="border-y border-parchment-line bg-parchment-light py-20">
    <Container size="lg">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading
          eyebrow="The Season's Favourites"
          title="Gifts Our Patrons Return For"
          lead="Small-batch, hand-finished pieces — each one wrapped in parchment, tied with satin and sealed with our brass 'M'."
        />
        <a href="/shop" class="btn-outline-dark shrink-0">
          Shop All
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 12h15m-6-6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </Container>
  </section>

  <!-- ============================= STORY ============================= -->
  <section class="bg-parchment py-20">
    <Container size="lg">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div class="relative">
          <div class="absolute -inset-3 rotate-[-2deg] rounded-[4px] border border-parchment-line bg-parchment-deep/60"></div>
          <div class="relative overflow-hidden rounded-[4px] border border-parchment-line shadow-[0_30px_60px_-32px_rgba(43,27,23,0.55)]">
            <img
              src="https://images.unsplash.com/photo-1513519245088-0e12902e5a38?w=900&auto=format&fit=crop&q=80"
              alt="A hand-wrapped Meghpeon gift parcel tied with satin ribbon"
              loading="lazy"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
          <div class="absolute -bottom-6 -right-4 h-20 w-20 rotate-[8deg]">
            <WaxSeal className="h-full w-full" letterClassName="text-[30px]" />
          </div>
        </div>

        <div>
          <SectionHeading
            eyebrow="Our Craft"
            title="A Parcel Should Feel Like a Letter"
            lead="We started in a small Dhaka studio with a simple belief: a gift is a sentence you cannot say out loud. So we wrap every one like it matters."
          />

          <p class="mt-5 text-[14px] leading-relaxed text-clay">
            Each order is assembled by hand — parchment cut and torn, satin tied, wax melted and pressed with our brass seal.
            Nothing is machine-wrapped, and nothing leaves the atelier without a handwritten note.
          </p>

          <dl class="mt-9 grid grid-cols-2 gap-6 border-t border-parchment-line pt-8">
            {stats.map((stat) => (
              <div key={stat.label}>
                <dt class="font-display text-[30px] leading-none text-espresso">{stat.value}</dt>
                <dd class="mt-1.5 text-[10.5px] font-semibold uppercase tracking-[0.18em] text-clay">{stat.label}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-9">
            <a href="/about" class="btn-outline-dark">Read Our Story</a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============================= TESTIMONIALS ============================= -->
  <section class="border-t border-parchment-line bg-parchment-light py-20">
    <Container size="lg">
      <SectionHeading
        align="center"
        eyebrow="Patron Letters"
        title="Kind Words, Delivered Back"
        lead="A few notes from the people who send — and receive — our parcels."
      />

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {testimonials.map((item) => (
          <figure key={item.name} class="flex h-full flex-col rounded-[4px] border border-parchment-line bg-parchment p-7">
            <span class="font-display text-[42px] leading-none text-gold-600/40" aria-hidden="true">“</span>
            <blockquote class="mt-2 flex-1 text-[13.5px] leading-relaxed text-espresso/[0.85]">{item.quote}</blockquote>
            <figcaption class="mt-6 border-t border-parchment-line pt-4">
              <Stars rating={5} />
              <p class="mt-2.5 text-[12.5px] font-semibold text-espresso">{item.name}</p>
              <p class="text-[11px] text-clay">{item.occasion} · {item.city}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============================= NEWSLETTER ============================= -->
  <section class="relative overflow-hidden bg-ink py-16 text-parchment">
    <div class="absolute inset-0 studio-backdrop"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(212,175,55,0.12),transparent_60%)]"></div>

    <Container size="md">
      <div class="relative rounded-[4px] border border-gold-600/30 px-6 py-12 text-center sm:px-12">
        <span class="eyebrow justify-center text-gold-300">
          <span class="h-px w-7 bg-gold-400/50"></span>
          The Postal Register
          <span class="h-px w-7 bg-gold-400/50"></span>
        </span>
        <h2 class="mt-4 font-display text-3xl font-semibold text-parchment sm:text-[38px]">
          One Letter a Month. Nothing Else.
        </h2>
        <p class="mx-auto mt-3 max-w-md text-[13.5px] leading-relaxed text-parchment/60">
          New collections, restocks and studio notes — written by hand, sent once a month.
        </p>

        <form class="mx-auto mt-8 flex max-w-md flex-col gap-2.5 sm:flex-row" action="/contact" method="get">
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            required
            placeholder="you@example.com"
            class="field flex-1 border-parchment/20 bg-white/[0.06] text-parchment placeholder:text-parchment/[0.35] focus:border-gold-500 focus:ring-gold-500/25"
          />
          <button type="submit" class="btn-gold shrink-0">Subscribe</button>
        </form>

        <p class="mt-4 text-[10.5px] uppercase tracking-[0.16em] text-parchment/[0.35]">
          No noise. Unsubscribe any time.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>