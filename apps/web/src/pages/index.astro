---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ProductCard from '../components/ui/ProductCard.astro';
import Stars from '../components/ui/Stars.astro';
import CategoryIcon from '../components/ui/CategoryIcon.astro';
import WaxSeal from '../components/hero-props/WaxSeal.astro';
import { BRAND, PRODUCT_CATEGORIES } from '@meghpiyon/shared';
import { fetchProducts } from '../lib/api';

const benefits = [
  {
    title: 'ফ্রি হোম ডেলিভারি',
    text: `৳ ২,০০০-এর বেশি অর্ডারে সারাদেশে ফ্রি ডেলিভারি`,
    icon: 'M3 7h11v8H3zM14 10h4l3 3v2h-7zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3zm11 0a1.5 1.5 0 100-3 1.5 1.5 0 000 3z',
  },
  {
    title: 'হাতে বাঁধা ও ওয়াক্স-সিল্ড প্যাকেজিং',
    text: 'আমাদের নিজস্ব স্টুডিওতে প্রতিটি পার্সেল যত্নে মোড়ানো',
    icon: 'M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7l7-4zm-2.5 8.5L12 14l2.5-2.5',
  },
  {
    title: '৬৪ জেলায় নিরাপদ ডেলিভারি',
    text: 'ট্র্যাকিং সুবিধাসহ দেশের যেকোনো প্রান্তে দ্রুত ডেলিভারি',
    icon: 'M12 21s7-5.5 7-11a7 7 0 10-14 0c0 5.5 7 11 7 11z',
  },
  {
    title: '৭ দিনের সহজ এক্সচেঞ্জ',
    text: 'পণ্য পরিবর্তন করতে চাইলে আমরা সবসময় পাশে আছি',
    icon: 'M4 12a8 8 0 0113.7-5.7L20 8M20 4v4h-4M20 12a8 8 0 01-13.7 5.7L4 16m0 4v-4h4',
  },
];

const categoryMeta: Record<string, { count: string; blurb: string; image: string; tag: string }> = {
  'custom-gifts': {
    count: '২৬টি উপহার',
    blurb: 'নাম, বিশেষ তারিখ ও নিজস্ব বার্তা খোদাই করা আজীবন স্মারক উপহার',
    image: 'https://images.unsplash.com/photo-1513519245088-0e12902e5a38?w=700&auto=format&fit=crop&q=80',
    tag: 'Custom Gifts',
  },
  'cakes-pastries': {
    count: '১৪টি ফ্লেভার',
    blurb: 'তাজা বেকড প্রিমিয়াম ডার্ক চকোলেট ট্রাফেল ও বিশেষ সেলিব্রেশন কেক',
    image: 'https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=700&auto=format&fit=crop&q=80',
    tag: 'Cakes & Pastries',
  },
  'mens-accessories': {
    count: '১৬টি উপহার',
    blurb: 'খাঁটি ব্রাস কাফলিংক, প্রিমিয়াম টাই-পিন ও জেনুইন লেদার ব্যান্ড',
    image: 'https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?w=700&auto=format&fit=crop&q=80',
    tag: "Men's Accessories",
  },
  chocolates: {
    count: '১৮টি উপহার',
    blurb: 'হাতে তৈরি খাঁটি বেলজিয়ান ট্রাফেল, ড্রাই ফ্রুটস ও রোস্টেড নাটস',
    image: 'https://images.unsplash.com/photo-1511381939415-e44015466834?w=700&auto=format&fit=crop&q=80',
    tag: 'Chocolates',
  },
  flowers: {
    count: '২২টি উপহার',
    blurb: 'গোলাপ ও বেলির সতেজ সুবাসিত তোড়া এবং ড্রাইড ফ্লাওয়ার',
    image: 'https://images.unsplash.com/photo-1561181286-d3fee7d55364?w=700&auto=format&fit=crop&q=80',
    tag: 'Flowers',
  },
  'womens-jewellery': {
    count: '১৫টি উপহার',
    blurb: 'খাঁটি পিতলের অ্যান্টিক ফিলিগ্রি, ঝুমকা ও রাজকীয় অলংকার বক্স',
    image: 'https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?w=700&auto=format&fit=crop&q=80',
    tag: "Women's Jewellery",
  },
  'combo-gift-box': {
    count: '২৮টি প্যাকেজ',
    blurb: 'ফুল, চকলেট, কেক ও চিরকুটের সমন্বয়ে ভালোবাসার কমপ্লিট প্যাকেজ',
    image: 'https://images.unsplash.com/photo-1543257580-7269da773bf5?w=700&auto=format&fit=crop&q=80',
    tag: 'Combo Gift Box',
  },
  others: {
    count: '১২টি উপহার',
    blurb: 'অনন্য হস্তশিল্প, পার্চমেন্ট চিরকুট ও সংগৃহীত বিশেষ উপহার সম্ভার',
    image: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=700&auto=format&fit=crop&q=80',
    tag: 'Others',
  },
};

const fallbackFeatured = [
  {
    name: 'Shonar Bangla Artisan Gift Box',
    nameBn: 'সোনার বাংলা উপহার বক্স',
    slug: 'shonar-bangla-artisan-gift-box',
    price: 2450,
    discountPrice: 2200,
    category: 'Curated Gift Box',
    image: 'https://images.unsplash.com/photo-1543257580-7269da773bf5?w=800&auto=format&fit=crop&q=80',
    tags: ['Best Seller'],
    rating: 4.9,
    reviewCount: 128,
  },
  {
    name: 'Nakshi Kantha Embroidered Diary & Pen',
    nameBn: 'নকশিকাঁথা ডায়েরি ও কলম',
    slug: 'nakshi-kantha-diary-pen',
    price: 1250,
    category: 'Handicrafts',
    image: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=800&auto=format&fit=crop&q=80',
    tags: ['Artisan Made'],
    rating: 4.8,
    reviewCount: 64,
  },
  {
    name: 'Artisanal Chocolates & Dry Fruits Hamper',
    nameBn: 'চকলেট ও ড্রাই ফ্রুটস হ্যাম্পার',
    slug: 'artisanal-chocolates-dry-fruits',
    price: 1850,
    category: 'Gourmet Hamper',
    image: 'https://images.unsplash.com/photo-1511381939415-e44015466834?w=800&auto=format&fit=crop&q=80',
    tags: ['Gourmet'],
    rating: 5,
    reviewCount: 91,
  },
  {
    name: 'Monsoon Jasmine & Rose Floral Box',
    nameBn: 'গোলাপ ও বেলি ফুলের বক্স',
    slug: 'monsoon-jasmine-rose-box',
    price: 1400,
    category: 'Fresh Flowers',
    image: 'https://images.unsplash.com/photo-1561181286-d3fee7d55364?w=800&auto=format&fit=crop&q=80',
    tags: ['Seasonal'],
    rating: 4.9,
    reviewCount: 57,
  },
];

// Fetch live products from backend (Atlas MongoDB)
const apiProducts = await fetchProducts();
const featuredList =
  apiProducts && apiProducts.length > 0
    ? (apiProducts.filter((p: any) => p.isFeatured).length > 0
        ? apiProducts.filter((p: any) => p.isFeatured)
        : apiProducts
      )
        .slice(0, 4)
        .map((p: any) => ({
          name: p.name,
          nameBn: p.nameBn || '',
          slug: p.slug,
          price: p.price,
          discountPrice: p.discountPrice,
          category: p.category,
          image: p.images?.[0] || 'https://images.unsplash.com/photo-1543257580-7269da773bf5?w=800&auto=format&fit=crop&q=80',
          tags: p.tags && p.tags.length > 0 ? p.tags : ['Featured'],
          rating: p.rating || 4.9,
          reviewCount: p.reviewCount || 50,
        }))
    : fallbackFeatured;

const featured = featuredList;

const stats = [
  { value: '12,000+', label: 'উপহার ডেলিভারি' },
  { value: '64', label: 'জেলায় নেটওয়ার্ক' },
  { value: '40+', label: 'আর্টিসান পার্টনার' },
  { value: '4.9', label: 'গড় সন্তুষ্টি রেটিং' },
];

const testimonials = [
  {
    quote:
      'পার্চমেন্ট কাগজ, সাটিন ফিতা আর মোমের সিলমোহরে মোড়ানো উপহারটি দেখে মা ভীষণ আবেগাপ্লুত হয়ে পড়েন। সাথে হাতে লেখা চিরকুটটি ছিল অসাধারণ—মনে হচ্ছিল পার্সেল নয়, ভালোবাসা মাখা এক টুকরো চিঠি পেয়েছি।',
    name: 'নুসরাত জাহান',
    city: 'ঢাকা',
    occasion: 'অ্যানিভার্সারি হ্যাম্পার',
  },
  {
    quote:
      'চট্টগ্রাম থেকে সকাল ১১টায় অর্ডার করেছিলাম, পরদিনই সিলেটে আমার বোনের ঠিকানায় অক্ষত অবস্থায় পৌঁছে গেছে। প্যাকেজিংয়ের আভিজাত্য আর প্রতিটি জিনিসের ফিনিশিং সত্যিই বিশ্বমানের।',
    name: 'তানভীর আহমেদ',
    city: 'চট্টগ্রাম',
    occasion: 'জন্মদিনের উপহার',
  },
  {
    quote:
      'নকশিকাঁথা ডায়েরির সূচিকর্ম আর বাঁধাই দেখে মুগ্ধ হয়েছি। নিখুঁত হস্তশিল্প, প্রিমিয়াম উপহার বক্স এবং তাদের আন্তরিক যোগাযোগ—মেঘপিয়ন থেকে উপহার পাঠানো সত্যি দারুণ এক অভিজ্ঞতা।',
    name: 'ফারহানা ইসলাম',
    city: 'সিলেট',
    occasion: 'পার্সোনালাইজড উপহার',
  },
];
---

<BaseLayout
  title={`${BRAND.name} — Bespoke Gift Hampers & Heirloom Keepsakes`}
  description={`${BRAND.name} crafts hand-tied gift hampers, vintage postal keepsakes and artisanal treasures, delivered across all 64 districts of Bangladesh.`}
>
  <!-- ============================= HERO ============================= -->
  <section class="relative min-h-[580px] sm:min-h-[640px] md:min-h-[720px] lg:min-h-[780px] xl:min-h-[840px] flex items-center justify-center overflow-hidden bg-[#240508] text-parchment border-b border-[#E5DEC9]">
    <!-- Atmospheric Vintage Photo Flatlay Background with Dried Flowers, Brass Scale, Hampers & Compass -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero-vintage-bg.jpg"
        alt="Meghpiyon — Handcrafted Sentiments, Delivered with Love"
        fetchpriority="high"
        width="2752"
        height="1536"
        class="w-full h-full object-cover object-center"
      />
    </div>

    <!-- Center Typography & Button on the Parchment Paper -->
    <div class="relative z-10 w-full max-w-[340px] sm:max-w-[420px] md:max-w-[460px] lg:max-w-[490px] px-4 mx-auto flex flex-col items-center justify-center text-center">
      <h1 class="font-tiro font-normal sm:font-medium text-[#2B1512] text-[28px] sm:text-[36px] md:text-[42px] lg:text-[48px] leading-[1.45] select-none text-balance">
        ভালোবাসা<br />
        পৌঁছে যাক,<br />
        উপহারে...
      </h1>

      <div class="mt-6 sm:mt-7 md:mt-8">
        <a
          href="/shop"
          class="group relative inline-flex items-center justify-center px-8 py-3 sm:px-9 sm:py-3.5 bg-[#B29258] hover:bg-[#9C7E48] text-[#F6F2EA] font-tiro text-base sm:text-lg tracking-normal rounded-[3px] shadow-[0_4px_16px_rgba(36,20,16,0.3)] transition-all duration-200 transform hover:-translate-y-0.5 border border-[#8F6F3A]"
        >
          <!-- Subtle inner border flourish -->
          <span class="pointer-events-none absolute inset-[3px] rounded-[2px] border border-[#F6F2EA]/40 group-hover:border-[#F6F2EA]/60 transition-colors"></span>
          <span class="mr-2.5 text-[11px] text-[#F6F2EA]/75 select-none font-serif">❖</span>
          <span class="font-medium pt-0.5">উপহার দেখুন</span>
          <span class="ml-2.5 text-[11px] text-[#F6F2EA]/75 select-none font-serif">❖</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================= BENEFITS ============================= -->
  <section class="border-b border-[#E5DEC9] bg-[#F6F2EA]">
    <Container size="lg">
      <div class="grid grid-cols-1 gap-6 py-9 sm:grid-cols-2 lg:grid-cols-4">
        {benefits.map((benefit) => (
          <div key={benefit.title} class="flex items-start gap-3.5">
            <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-gold-600/25 bg-gold-500/[0.07] text-gold-700">
              <svg class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <path d={benefit.icon} />
              </svg>
            </span>
            <div>
              <p class="font-bengali text-[15px] sm:text-base font-semibold text-espresso">{benefit.title}</p>
              <p class="mt-1 font-bengali text-[13.5px] sm:text-[14.5px] leading-[1.65] text-clay">{benefit.text}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============================= CATEGORIES ============================= -->
  <section class="bg-parchment py-20">
    <Container size="lg">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading
          eyebrow="কিউরেটেড কালেকশন"
          title="বিশেষ দিনের উপহার সম্ভার"
          lead="প্রিয়জনের প্রতিটি মুহূর্ত স্মরণীয় করে রাখতে আমাদের বিশেষ কালেকশন—চিরকুট, ফুল ও নান্দনিক উপহারে সাজানো।"
        />
        <a href="/shop" class="btn-outline-dark shrink-0">
          View All Gifts
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 12h15m-6-6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {PRODUCT_CATEGORIES.map((cat) => {
          const meta = categoryMeta[cat.id] ?? {
            count: 'উপহার সম্ভার',
            blurb: 'মেঘপিয়নের বিশেষ কিউরেটেড উপহার',
            image: 'https://images.unsplash.com/photo-1543257580-7269da773bf5?w=700&auto=format&fit=crop&q=80',
            tag: 'Curated',
          };
          return (
            <a
              href={`/shop?category=${cat.id}`}
              class="group flex flex-col overflow-hidden rounded-[4px] border border-parchment-line bg-parchment-light shadow-[inset_0_1px_0_rgba(255,255,255,0.85),0_18px_36px_-24px_rgba(43,27,23,0.35)] transition-all duration-300 hover:-translate-y-1.5 hover:border-gold-500/70 hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.95),0_26px_48px_-20px_rgba(43,27,23,0.45)]"
            >
              <!-- Vintage Image Header with Aspect Ratio & Warm Vignette -->
              <div class="relative aspect-[16/11] overflow-hidden bg-parchment-deep">
                <img
                  src={meta.image}
                  alt={`${cat.nameBn} - ${cat.nameEn}`}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                />
                <!-- Subtle vintage vignette gradient -->
                <div class="absolute inset-0 bg-gradient-to-t from-ink-deep/70 via-transparent to-black/10"></div>
                
                <!-- Vintage Tag Stamp / Badge -->
                <span class="absolute top-3 left-3 rounded-[3px] border border-gold-400/40 bg-ink/80 px-2.5 py-1 font-sans text-[9px] font-semibold uppercase tracking-[0.16em] text-gold-200 backdrop-blur-sm shadow-sm">
                  {meta.tag}
                </span>

                <!-- Count pill inside image bottom right -->
                <span class="absolute bottom-2.5 right-3 font-bengali text-[11px] font-medium text-parchment/95 drop-shadow">
                  {meta.count}
                </span>
              </div>

              <!-- Card Body Content -->
              <div class="flex flex-1 flex-col p-5 sm:p-5.5">
                <h3 class="font-display text-[19px] sm:text-[20px] font-semibold leading-snug text-espresso transition-colors duration-200 group-hover:text-ink">
                  {cat.nameEn}
                </h3>
                <p class="mt-0.5 font-bengali text-[14px] font-medium text-gold-800">
                  {cat.nameBn}
                </p>
                <p class="mt-2 font-bengali text-[13px] leading-[1.65] text-clay line-clamp-2">
                  {meta.blurb}
                </p>

                <!-- Action Footer -->
                <div class="mt-auto pt-4 flex items-center justify-between border-t border-parchment-line/60">
                  <span class="font-bengali text-[12.5px] font-semibold text-espresso/85 transition-colors group-hover:text-burgundy">
                    কালেকশন দেখুন
                  </span>
                  <span class="flex h-6 w-6 items-center justify-center rounded-full bg-parchment text-espresso/70 transition-all duration-200 group-hover:bg-gold-500/20 group-hover:text-ink group-hover:translate-x-1" aria-hidden="true">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- ============================= FEATURED ============================= -->
  <section class="border-y border-parchment-line bg-parchment-light py-20">
    <Container size="lg">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <SectionHeading
          eyebrow="এই সপ্তাহের সেরা পছন্দ"
          title="জনপ্রিয় উপহারসমূহ"
          lead="স্বজনদের জন্য হাতে সাজানো বিশেষ সব উপহার বক্স, প্রতিটিতে রয়েছে প্রেম ও আন্তরিকতার ছোঁয়া।"
        />
        <a href="/shop" class="btn-outline-dark shrink-0">
          Shop All
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 12h15m-6-6l6 6-6 6" />
          </svg>
        </a>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </Container>
  </section>

  <!-- ============================= STORY ============================= -->
  <section class="relative overflow-hidden bg-parchment py-20 lg:py-24 border-y border-parchment-line">
    <!-- Atmospheric Vintage Background -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/special-section.jpeg"
        alt=""
        class="w-full h-full object-cover object-center pointer-events-none select-none"
        loading="lazy"
        decoding="async"
      />
    </div>

    <Container size="lg" className="relative z-10">
      <div class="grid items-center gap-14 lg:grid-cols-2">
        <div class="relative">
          <div class="absolute -inset-3 rotate-[-2deg] rounded-[4px] border border-parchment-line bg-parchment-deep/60"></div>
          <div class="relative overflow-hidden rounded-[4px] border border-parchment-line shadow-[0_30px_60px_-32px_rgba(43,27,23,0.55)]">
            <img
              src="/images/gift.jpeg"
              alt="A hand-wrapped Meghpeon gift parcel tied with satin ribbon"
              loading="lazy"
              decoding="async"
              width="2752"
              height="1536"
              class="aspect-[4/3] w-full object-cover"
            />
          </div>
          <div class="absolute -bottom-6 -right-4 h-20 w-20 rotate-[8deg]">
            <WaxSeal className="h-full w-full" letterClassName="text-[30px]" />
          </div>
        </div>

        <div>
          <SectionHeading
            eyebrow="আমাদের সৃষ্টি ও ঐতিহ্য"
            title="প্রতিটি উপহার যেন একটি ভালোবাসা মাখা চিঠি"
            lead="পার্চমেন্ট কাগজ কাটা, সাটিন ফিতায় গিঁট বাঁধা এবং গলানো মোমের সিলমোহর—প্রতিটি উপহারে রয়েছে আন্তরিকতার পরশ।"
          />

          <p class="mt-5 font-bengali text-[15px] md:text-base leading-[1.75] text-clay">
            প্রতিটি উপহার বাক্স আমরা পরম যত্নে প্রস্তুত করি—হাতে কাটা পার্চমেন্ট কাগজ, সাটিন রিবনের বাঁধন এবং খাঁটি ব্রাস দিয়ে ওয়াক্স সিলমোহর।
            যান্ত্রিকতার ভিড়ে আমরা বিশ্বাস করি হাতে তৈরি আন্তরিকতায়, যেখানে প্রতিটি পার্সেলের সাথে যায় হাতে লেখা চিরকুট।
          </p>

          <dl class="mt-9 grid grid-cols-2 gap-6 border-t border-parchment-line pt-8">
            {stats.map((stat) => (
              <div key={stat.label}>
                <dt class="font-display text-[30px] leading-none text-espresso">{stat.value}</dt>
                <dd class="mt-1.5 font-bengali text-[13px] md:text-[14px] font-medium text-clay">{stat.label}</dd>
              </div>
            ))}
          </dl>

          <div class="mt-9">
            <a href="/about" class="btn-outline-dark font-bengali">আমাদের গল্প জানুন →</a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ============================= TESTIMONIALS ============================= -->
  <section class="border-t border-parchment-line bg-parchment-light py-20">
    <Container size="lg">
      <SectionHeading
        align="center"
        eyebrow="গ্রাহকদের ভালোবাসার কথা"
        title="চিঠির ভাষায় আন্তরিক অনুভূতি"
        lead="যাঁরা আমাদের উপহার পাঠিয়েছেন এবং পেয়েছেন, তাঁদের কিছু ভালোবাসার প্রকাশ।"
      />

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {testimonials.map((item) => (
          <figure key={item.name} class="flex h-full flex-col rounded-[4px] border border-parchment-line bg-parchment p-7 shadow-[0_10px_30px_-20px_rgba(43,27,23,0.3)]">
            <span class="font-display text-[42px] leading-none text-gold-600/40" aria-hidden="true">“</span>
            <blockquote class="mt-2.5 flex-1 font-bengali text-[15px] md:text-base leading-[1.75] text-espresso/[0.88]">{item.quote}</blockquote>
            <figcaption class="mt-6 border-t border-parchment-line pt-4">
              <Stars rating={5} />
              <p class="mt-2.5 font-bengali text-[14px] md:text-[15px] font-semibold text-espresso">{item.name}</p>
              <p class="mt-0.5 font-bengali text-xs md:text-[13px] text-clay">{item.occasion} · {item.city}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </Container>
  </section>

  <!-- ============================= NEWSLETTER ============================= -->
  <section class="relative overflow-hidden bg-ink py-16 text-parchment">
    <div class="absolute inset-0 studio-backdrop"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(212,175,55,0.12),transparent_60%)]"></div>

    <Container size="md">
      <div class="relative rounded-[4px] border border-gold-600/30 px-6 py-12 text-center sm:px-12">
        <span class="eyebrow justify-center text-gold-300">
          <span class="h-px w-7 bg-gold-400/50"></span>
          পোস্টাল রেজিস্টার
          <span class="h-px w-7 bg-gold-400/50"></span>
        </span>
        <h2 class="mt-4 font-tiro text-3xl font-medium text-parchment sm:text-[38px] leading-[1.35]">
          মাসে একটি চিঠি, একান্তই আপনার জন্য
        </h2>
        <p class="mx-auto mt-3 max-w-md text-[13.5px] leading-relaxed text-parchment/60 font-bengali">
          নতুন উপহার কালেকশন, গল্প ও স্টুডিও নোটস—অপ্রয়োজনীয় স্প্যাম ছাড়াই মাসে একটিমাত্র চিঠি।
        </p>

        <form class="mx-auto mt-8 flex max-w-md flex-col gap-2.5 sm:flex-row" action="/contact" method="get">
          <label class="sr-only" for="newsletter-email">Email address</label>
          <input
            id="newsletter-email"
            type="email"
            required
            placeholder="your-email@example.com"
            class="field flex-1 border-parchment/20 bg-white/[0.06] text-parchment placeholder:text-parchment/[0.35] focus:border-gold-500 focus:ring-gold-500/25"
          />
          <button type="submit" class="btn-gold shrink-0">Subscribe</button>
        </form>

        <p class="mt-4 text-[10.5px] uppercase tracking-[0.16em] text-parchment/[0.35]">
          No noise. Unsubscribe any time.
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>