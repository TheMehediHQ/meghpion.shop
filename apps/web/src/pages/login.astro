---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { BRAND } from '@meghpiyon/shared';
---

<BaseLayout
  title={`Sign In | ${BRAND.name}`}
  description="Sign in to your Meghpiyon account to track orders, manage addresses, and view your gift history."
>
  <div class="py-16 bg-sky-50/40 min-h-[70vh] flex items-center">
    <Container size="sm">
      <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-10 shadow-sm max-w-md mx-auto space-y-6">
        <div class="text-center space-y-2">
          <div class="w-10 h-10 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-lg mx-auto shadow-sm">
            ম
          </div>
          <h1 class="text-2xl font-bold text-slate-900 tracking-tight">
            Sign In to {BRAND.name}
          </h1>
          <p class="text-xs text-slate-500 font-bengali">
            {BRAND.tagline}
          </p>
        </div>

        <form class="space-y-4" action="/shop" method="GET">
          <div class="space-y-1">
            <label for="emailOrPhone" class="block text-xs font-semibold text-slate-700">
              Email Address or Phone Number
            </label>
            <input
              type="text"
              id="emailOrPhone"
              name="emailOrPhone"
              required
              placeholder="e.g. 01700000000 or user@example.com"
              class="input-field"
            />
          </div>

          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label for="password" class="block text-xs font-semibold text-slate-700">
                Password
              </label>
              <a href="#" class="text-[11px] text-sky-600 hover:underline">
                Forgot password?
              </a>
            </div>
            <input
              type="password"
              id="password"
              name="password"
              required
              placeholder="••••••••"
              class="input-field"
            />
          </div>

          <div class="flex items-center text-xs text-slate-600 gap-2">
            <input type="checkbox" id="remember" name="remember" class="rounded text-sky-600 focus:ring-sky-500" />
            <label for="remember">Keep me signed in</label>
          </div>

          <button type="submit" class="btn-primary w-full py-2.5 text-sm justify-center shadow">
            Sign In
          </button>
        </form>

        <div class="border-t border-slate-100 pt-4 text-center text-xs text-slate-600">
          Don't have an account yet?{' '}
          <a href="/register" class="text-sky-600 font-semibold hover:underline">
            Create an Account
          </a>
        </div>
      </div>
    </Container>
  </div>
</BaseLayout>
