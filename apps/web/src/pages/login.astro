---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { CustomerAuth } from '../components/auth/CustomerAuth';
import { BRAND } from '@meghpiyon/shared';
---

<BaseLayout
  title={`Sign In | ${BRAND.name}`}
  description="Sign in to your Meghpiyon account to track orders, manage addresses, and view your gift history."
>
  <div class="py-16 bg-sky-50/40 min-h-[70vh] flex items-center">
    <Container size="sm">
      <CustomerAuth mode="login" redirectUrl="/shop" client:only="react" />
    </Container>
  </div>
</BaseLayout>
