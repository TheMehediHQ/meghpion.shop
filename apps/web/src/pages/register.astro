---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { CustomerAuth } from '../components/auth/CustomerAuth';
import { BRAND } from '@meghpiyon/shared';
---

<BaseLayout
  title={`Create an Account | ${BRAND.name}`}
  description="Register for a Meghpeon account to save delivery addresses and send meaningful gifts easily."
>
  <section class="relative overflow-hidden bg-parchment paper-grain py-14 sm:py-20 min-h-[75vh] flex items-center">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(203,160,56,0.08),transparent_55%)]"></div>
    <Container size="sm" className="relative z-10">
      <CustomerAuth mode="register" redirectUrl="/shop" client:only="react" />
    </Container>
  </section>
</BaseLayout>
