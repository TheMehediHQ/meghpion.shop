---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { CustomerAuth } from '../components/auth/CustomerAuth';
import { BRAND } from '@meghpiyon/shared';
---

<BaseLayout
  title={`Create an Account | ${BRAND.name}`}
  description="Register for a Meghpeon account to save delivery addresses and send meaningful gifts easily."
>
  <div class="py-16 bg-sky-50/40 min-h-[70vh] flex items-center">
    <Container size="sm">
      <CustomerAuth mode="register" redirectUrl="/shop" client:only="react" />
    </Container>
  </div>
</BaseLayout>
