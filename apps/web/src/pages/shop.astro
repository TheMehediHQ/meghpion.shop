---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Badge from '../components/ui/Badge.astro';
import { BRAND, PRODUCT_CATEGORIES } from '@meghpiyon/shared';

const selectedCategory = Astro.url.searchParams.get('category') || 'all';

// Curated gift catalog samples
const products = [
  {
    id: '1',
    name: 'Shonar Bangla Artisan Gift Box',
    nameBn: 'সোনার বাংলা উপহার বক্স',
    slug: 'shonar-bangla-artisan-gift-box',
    price: 2450,
    discountPrice: 2200,
    category: 'gift-boxes',
    image: 'https://images.unsplash.com/photo-1549465220-1a8b9238cd48?w=600&auto=format&fit=crop&q=80',
    tags: ['Best Seller', 'Handcrafted'],
    rating: 5,
  },
  {
    id: '2',
    name: 'Nakshi Kantha Embroidered Diary & Pen',
    nameBn: 'নকশিকাঁথা ডায়েরি ও কলম',
    slug: 'nakshi-kantha-diary-pen',
    price: 1250,
    category: 'handicrafts',
    image: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=600&auto=format&fit=crop&q=80',
    tags: ['Traditional'],
    rating: 4.9,
  },
  {
    id: '3',
    name: 'Artisanal Chocolates & Dry Fruits Hamper',
    nameBn: 'চকলেট ও ড্রাই ফ্রুটস হ্যাম্পার',
    slug: 'artisanal-chocolates-dry-fruits',
    price: 1850,
    category: 'chocolates',
    image: 'https://images.unsplash.com/photo-1511381939415-e44015466834?w=600&auto=format&fit=crop&q=80',
    tags: ['Gourmet'],
    rating: 5,
  },
  {
    id: '4',
    name: 'Personalized Wooden Photo Frame & Keepsake',
    nameBn: 'কাঠের কাস্টমাইজড ফটো ফ্রেম',
    slug: 'personalized-wooden-photo-frame',
    price: 950,
    category: 'customized',
    image: 'https://images.unsplash.com/photo-1513519245088-0e12902e5a38?w=600&auto=format&fit=crop&q=80',
    tags: ['Customized'],
    rating: 4.8,
  },
  {
    id: '5',
    name: 'Monsoon Jasmine & Rose Floral Box',
    nameBn: 'গোলাপ ও বেলি ফুলের বক্স',
    slug: 'monsoon-jasmine-rose-box',
    price: 1400,
    category: 'flowers',
    image: 'https://images.unsplash.com/photo-1561181286-d3fee7d55364?w=600&auto=format&fit=crop&q=80',
    tags: ['Fragrant'],
    rating: 4.9,
  },
  {
    id: '6',
    name: 'Handmade Terracotta Desk Planter',
    nameBn: 'টেরাকোটা প্ল্যান্টার',
    slug: 'handmade-terracotta-planter',
    price: 650,
    category: 'handicrafts',
    image: 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?w=600&auto=format&fit=crop&q=80',
    tags: ['Eco-friendly'],
    rating: 4.7,
  },
];

const filteredProducts =
  selectedCategory === 'all'
    ? products
    : products.filter((p) => p.category === selectedCategory);
---

<BaseLayout
  title={`Shop Gifts | ${BRAND.name}`}
  description="Discover our collection of curated gift boxes, traditional Bangladeshi handicrafts, personalized tokens, and fresh floral hampers."
>
  <div class="bg-sky-50/50 border-b border-slate-200 py-8">
    <Container size="lg">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
            Curated Gift Collection
          </h1>
          <p class="text-sm text-slate-600 mt-1">
            Hand-selected, beautifully presented, and delivered with your personal note.
          </p>
        </div>
        <p class="text-xs text-sky-700 font-medium">
          Showing {filteredProducts.length} items
        </p>
      </div>

      <!-- Categories Filter Tabs -->
      <div class="flex items-center gap-2 overflow-x-auto pt-6 pb-2 scrollbar-none">
        <a
          href="/shop"
          class={`px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap border ${
            selectedCategory === 'all'
              ? 'bg-sky-600 text-white border-sky-600'
              : 'bg-white text-slate-700 border-slate-200 hover:border-sky-300'
          }`}
        >
          All Items
        </a>
        {PRODUCT_CATEGORIES.map((cat) => (
          <a
            href={`/shop?category=${cat.id}`}
            class={`px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap border ${
              selectedCategory === cat.id
                ? 'bg-sky-600 text-white border-sky-600'
                : 'bg-white text-slate-700 border-slate-200 hover:border-sky-300'
            }`}
          >
            {cat.nameEn}
          </a>
        ))}
      </div>
    </Container>
  </div>

  <!-- Product Grid -->
  <section class="py-12 bg-white">
    <Container size="lg">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {filteredProducts.map((product) => (
          <div class="bg-white border border-slate-200 rounded-xl overflow-hidden flex flex-col">
            <div class="relative aspect-square bg-slate-100 overflow-hidden">
              <img
                src={product.image}
                alt={product.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
              {product.tags.length > 0 && (
                <div class="absolute top-3 left-3 flex flex-wrap gap-1">
                  {product.tags.map((tag) => (
                    <span class="px-2 py-0.5 bg-white/90 backdrop-blur-none text-sky-700 text-[11px] font-semibold rounded shadow-sm border border-sky-100">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <div class="p-5 flex-1 flex flex-col">
              <span class="text-[11px] font-semibold text-sky-600 uppercase tracking-wider">
                {product.category.replace('-', ' ')}
              </span>

              <h2 class="text-base font-semibold text-slate-900 mt-1">
                <a href={`/product/${product.slug}`} class="hover:text-sky-600">
                  {product.name}
                </a>
              </h2>

              <p class="text-xs text-slate-500 font-bengali mt-0.5">
                {product.nameBn}
              </p>

              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between">
                <div class="flex items-baseline gap-2">
                  <span class="text-lg font-bold text-slate-900">
                    {BRAND.currencySymbol}{product.discountPrice ?? product.price}
                  </span>
                  {product.discountPrice && (
                    <span class="text-xs text-slate-400 line-through">
                      {BRAND.currencySymbol}{product.price}
                    </span>
                  )}
                </div>

                <a
                  href={`/product/${product.slug}`}
                  class="btn-outline text-xs px-3 py-1.5"
                >
                  View Details
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>
