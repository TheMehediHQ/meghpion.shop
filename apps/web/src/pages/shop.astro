---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import ProductCard from '../components/ui/ProductCard.astro';
import { BRAND, PRODUCT_CATEGORIES } from '@meghpiyon/shared';

const selectedCategory = Astro.url.searchParams.get('category') || 'all';

const products = [
  {
    id: '1',
    name: 'Shonar Bangla Artisan Gift Box',
    nameBn: 'সোনার বাংলা উপহার বক্স',
    slug: 'shonar-bangla-artisan-gift-box',
    price: 2450,
    discountPrice: 2200,
    category: 'Curated Gift Box',
    image: 'https://images.unsplash.com/photo-1543257580-7269da773bf5?w=600&auto=format&fit=crop&q=80',
    tags: ['Best Seller'],
    rating: 4.9,
    reviewCount: 128,
  },
  {
    id: '2',
    name: 'Nakshi Kantha Embroidered Diary & Pen',
    nameBn: 'নকশিকাঁথা ডায়েরি ও কলম',
    slug: 'nakshi-kantha-diary-pen',
    price: 1250,
    category: 'Handicrafts',
    image: 'https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?w=600&auto=format&fit=crop&q=80',
    tags: ['Artisan Made'],
    rating: 4.8,
    reviewCount: 64,
  },
  {
    id: '3',
    name: 'Artisanal Chocolates & Dry Fruits Hamper',
    nameBn: 'চকলেট ও ড্রাই ফ্রুটস হ্যাম্পার',
    slug: 'artisanal-chocolates-dry-fruits',
    price: 1850,
    category: 'Gourmet Hamper',
    image: 'https://images.unsplash.com/photo-1511381939415-e44015466834?w=600&auto=format&fit=crop&q=80',
    tags: ['Gourmet'],
    rating: 5,
    reviewCount: 91,
  },
  {
    id: '4',
    name: 'Personalised Wooden Photo Frame & Keepsake',
    nameBn: 'কাঠের কাস্টমাইজড ফটো ফ্রেম',
    slug: 'personalized-wooden-photo-frame',
    price: 950,
    category: 'Personalised',
    image: 'https://images.unsplash.com/photo-1513519245088-0e12902e5a38?w=600&auto=format&fit=crop&q=80',
    tags: ['Personalised'],
    rating: 4.8,
    reviewCount: 43,
  },
  {
    id: '5',
    name: 'Monsoon Jasmine & Rose Floral Box',
    nameBn: 'গোলাপ ও বেলি ফুলের বক্স',
    slug: 'monsoon-jasmine-rose-box',
    price: 1400,
    category: 'Fresh Flowers',
    image: 'https://images.unsplash.com/photo-1561181286-d3fee7d55364?w=600&auto=format&fit=crop&q=80',
    tags: ['Seasonal'],
    rating: 4.9,
    reviewCount: 57,
  },
  {
    id: '6',
    name: 'Handmade Terracotta Desk Planter',
    nameBn: 'টেরাকোটা প্ল্যান্টার',
    slug: 'handmade-terracotta-planter',
    price: 650,
    category: 'Handicrafts',
    image: 'https://images.unsplash.com/photo-1485955900006-10f4d324d411?w=600&auto=format&fit=crop&q=80',
    tags: ['Eco-friendly'],
    rating: 4.7,
    reviewCount: 38,
  },
];

const filteredProducts =
  selectedCategory === 'all' ? products : products.filter((p) => p.category === selectedCategory);
---

<BaseLayout
  title={`Collections | ${BRAND.name}`}
  description="Browse curated gift boxes, Bangladeshi handicrafts, personalised keepsakes and floral hampers — hand-finished and delivered nationwide."
>
  <!-- Page header -->
  <section class="relative overflow-hidden border-b border-parchment-line bg-parchment">
    <div class="absolute inset-0 paper-grain opacity-60"></div>
    <Container size="lg" className="relative py-14">
      <nav class="flex items-center gap-2 text-[10.5px] font-medium uppercase tracking-[0.18em] text-clay/70" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-ink">Home</a>
        <span class="text-clay/40">/</span>
        <span class="text-espresso">Collections</span>
      </nav>

      <div class="mt-6 flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <span class="eyebrow">
            <span class="h-px w-7 bg-gold-600/60"></span>
            The Collection
          </span>
          <h1 class="section-title mt-4">Curated Gifts &amp; Heirloom Keepsakes</h1>
          <p class="section-lead">
            Hand-selected pieces, finished by hand in our Dhaka atelier and delivered with a written note.
          </p>
        </div>
        <p class="shrink-0 text-[11px] font-semibold uppercase tracking-[0.18em] text-clay">
          {filteredProducts.length} {filteredProducts.length === 1 ? 'piece' : 'pieces'}
        </p>
      </div>

      <!-- Category filters -->
      <div class="mt-9 flex flex-wrap gap-2">
        <a
          href="/shop"
          class={`rounded-full border px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] transition-colors ${
            selectedCategory === 'all'
              ? 'border-ink bg-ink text-parchment'
              : 'border-parchment-line bg-parchment-light text-clay hover:border-gold-600/50 hover:text-espresso'
          }`}
        >
          All Gifts
        </a>
        {PRODUCT_CATEGORIES.map((cat) => (
          <a
            key={cat.id}
            href={`/shop?category=${cat.id}`}
            class={`rounded-full border px-4 py-2 text-[11px] font-semibold uppercase tracking-[0.14em] transition-colors ${
              selectedCategory === cat.id
                ? 'border-ink bg-ink text-parchment'
                : 'border-parchment-line bg-parchment-light text-clay hover:border-gold-600/50 hover:text-espresso'
            }`}
          >
            {cat.nameEn}
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- Product grid -->
  <section class="bg-parchment-light py-14">
    <Container size="lg">
      {filteredProducts.length > 0 ? (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {filteredProducts.map((product) => (
            <ProductCard product={product} />
          ))}
        </div>
      ) : (
        <div class="mx-auto max-w-md rounded-[4px] border border-parchment-line bg-parchment px-8 py-16 text-center">
          <p class="font-display text-2xl text-espresso">Nothing here yet</p>
          <p class="mt-2 text-[13px] leading-relaxed text-clay">
            This collection is being restyled. Explore the full atelier in the meantime.
          </p>
          <a href="/shop" class="btn-outline-dark mt-6">View All Gifts</a>
        </div>
      )}
    </Container>
  </section>
</BaseLayout>