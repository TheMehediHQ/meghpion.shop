---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import { BRAND } from '@meghpiyon/shared';

const queryOrder = Astro.url.searchParams.get('order') || 'MP-17403';
---

<BaseLayout
  title={`অর্ডার ট্র্যাকিং | ${BRAND.name}`}
  description="মেঘপিয়ন থেকে পাঠানো আপনার ভালোবাসার উপহারের পার্সেলটি বর্তমানে কোন ধাপে রয়েছে তা রিয়েল-টাইমে ট্র্যাক করুন।"
>
  <!-- Atmospheric Page Header -->
  <section class="relative overflow-hidden bg-ink text-parchment">
    <div class="absolute inset-0 studio-backdrop opacity-70"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_30%_20%,rgba(212,175,55,0.15),transparent_65%)]"></div>

    <Container size="lg" className="relative py-14 sm:py-18 text-center">
      <span class="inline-flex items-center gap-2 font-bengali text-[12px] sm:text-[13px] font-medium tracking-wider text-gold-300">
        <span class="h-px w-6 sm:w-8 bg-gold-400/50"></span>
        লাইভ পার্সেল ট্র্যাকিং · PARCEL DISPATCH
        <span class="h-px w-6 sm:w-8 bg-gold-400/50"></span>
      </span>

      <h1 class="mt-4 font-tiro text-[32px] sm:text-[44px] md:text-[50px] font-normal leading-[1.3] text-parchment">
        আপনার উপহারের পার্সেল ট্র্যাক করুন
      </h1>

      <p class="mx-auto mt-3 max-w-2xl font-bengali text-[15px] sm:text-base leading-relaxed text-gold-200/90">
        অর্ডার নম্বর বা ট্র্যাকিং আইডি দিয়ে এক ক্লিকে জেনে নিন আপনার ভালোবাসার উপহারটি বর্তমানে কোন ধাপে রয়েছে—প্যাকিং, সিলমোহর নাকি ডোরস্টেপ ডেলিভারিতে।
      </p>

      <!-- Breadcrumb in Header -->
      <nav class="mt-6 flex items-center justify-center gap-2 font-bengali text-[12px] text-parchment/60" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-gold-300">হোম</a>
        <span class="text-gold-400/40">/</span>
        <span class="text-gold-200 font-medium">অর্ডার ট্র্যাকিং</span>
      </nav>
    </Container>

    <!-- Airmail stripe divider -->
    <div class="h-[2px] w-full airmail-stripe"></div>
  </section>

  <!-- Main Tracking Section -->
  <section class="bg-parchment-light py-12 sm:py-16">
    <Container size="md">
      <!-- Tracking Search Box (Vintage Postal Registry Form) -->
      <div class="mb-10 overflow-hidden rounded-[6px] border border-parchment-line bg-parchment p-6 sm:p-8 shadow-[0_10px_25px_-18px_rgba(43,27,23,0.2)]">
        <div class="mb-4">
          <span class="font-bengali text-xs font-semibold uppercase tracking-wider text-gold-700">
            ডাকপিয়ন ট্র্যাকিং রেজিস্ট্রার
          </span>
          <h2 class="mt-1 font-tiro text-xl sm:text-2xl text-espresso">
            অর্ডার নম্বর বা ট্র্যাকিং আইডি লিখুন
          </h2>
        </div>

        <form id="trackForm" class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex-1">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-clay/70">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </span>
            <input
              type="text"
              id="orderInput"
              name="order"
              value={queryOrder}
              required
              placeholder="যেমন: MP-17403"
              class="field w-full pl-10 border-parchment-line bg-white font-sans text-sm focus:border-gold-500 uppercase"
            />
          </div>
          <button
            type="submit"
            id="trackBtn"
            class="inline-flex items-center justify-center gap-2 rounded-[3px] bg-ink px-7 py-3 font-bengali text-sm font-medium text-parchment shadow-md transition-all hover:bg-burgundy hover:text-gold-200"
          >
            <span>ট্র্যাক করুন</span>
            <span>→</span>
          </button>
        </form>

        <div class="mt-3 flex items-center gap-2 font-bengali text-xs text-clay">
          <span>উদাহরণ ট্র্যাকিং আইডি:</span>
          <a href="/track-order?order=MP-17403" class="font-sans font-semibold text-gold-700 underline hover:text-ink">MP-17403</a>
        </div>
      </div>

      <!-- Loading Indicator -->
      <div id="loadingBox" class="hidden my-8 text-center py-10 bg-parchment rounded-[6px] border border-parchment-line">
        <div class="inline-block h-8 w-8 animate-spin rounded-full border-4 border-solid border-gold-600 border-r-transparent"></div>
        <p class="mt-3 font-bengali text-sm text-clay">ডাকপিয়ন সার্ভার থেকে পার্সেলের তথ্য লোড হচ্ছে...</p>
      </div>

      <!-- Error Card (When Order Not Found) -->
      <div id="errorCard" class="hidden my-8 rounded-[6px] border border-rose-300 bg-rose-50/70 p-6 text-center">
        <span class="text-3xl">📭</span>
        <h3 class="mt-2 font-tiro text-xl text-rose-900" id="errorTitle">অর্ডারটি খুঁজে পাওয়া যায়নি</h3>
        <p class="mt-1 font-bengali text-xs sm:text-sm text-rose-700" id="errorMessage">
          অনুগ্রহ করে আপনার সঠিক অর্ডার নম্বরটি চেক করে পুনরায় চেষ্টা করুন।
        </p>
      </div>

      <!-- Tracking Result Card (Vintage Airmail Theme) -->
      <div id="resultCard" class="overflow-hidden rounded-[6px] border border-parchment-line bg-parchment p-6 sm:p-9 shadow-[0_12px_32px_-18px_rgba(43,27,23,0.25)]">
        <!-- Airmail top stripe inside card -->
        <div class="h-[2px] w-full airmail-stripe mb-6"></div>

        <!-- Order Meta Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-parchment-line gap-4">
          <div>
            <div class="flex items-center gap-2">
              <span class="font-bengali text-xs font-semibold uppercase tracking-wider text-gold-700">
                পার্সেল ট্র্যাকিং রেফারেন্স
              </span>
              <span class="text-[10px] text-clay font-sans">#MEGHPEON-ATLAS</span>
            </div>
            <h3 id="displayOrderNum" class="mt-1 font-sans text-2xl font-bold tracking-tight text-espresso sm:text-3xl">
              {queryOrder}
            </h3>
            <p id="displayCustomer" class="mt-1 font-bengali text-xs text-clay">
              প্রাপক: <strong class="text-espresso">মেহেদী হাসান</strong> · ঢাকা (ধানমন্ডি)
            </p>
          </div>

          <!-- Status Pill -->
          <div class="flex items-center gap-2 self-start sm:self-center">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
            </span>
            <span id="displayStatus" class="rounded-full border border-emerald-700/25 bg-emerald-600/[0.08] px-3.5 py-1.5 font-bengali text-xs font-semibold text-emerald-800">
              অর্ডার গৃহীত হয়েছে
            </span>
          </div>
        </div>

        <!-- Ordered Items Summary -->
        <div id="itemsBox" class="py-4 border-b border-parchment-line">
          <p class="font-bengali text-xs font-semibold text-gold-800 uppercase tracking-wider mb-2">উপহার সামগ্রী:</p>
          <div id="displayItems" class="space-y-1.5 font-bengali text-xs text-espresso">
            <!-- Populated via live API -->
          </div>
          <div class="mt-3 flex justify-between font-sans text-xs text-clay pt-2 border-t border-parchment-line/50">
            <span>মোট প্রদেয়: <strong id="displayTotal" class="text-espresso font-bold">৳০</strong></span>
            <span id="displayPaymentMethod" class="capitalize">Payment: COD</span>
          </div>
        </div>

        <!-- Tracking Timeline -->
        <div id="displayTimeline" class="mt-8 space-y-8 relative pl-7 before:content-[''] before:absolute before:left-2.5 before:top-2 before:bottom-2 before:w-[2px] before:bg-parchment-line">
          <!-- Populated dynamically via live API -->
        </div>

        <!-- Help & Concierge Box at Bottom -->
        <div class="mt-10 pt-6 border-t border-parchment-line flex flex-col sm:flex-row items-center justify-between gap-4 font-bengali text-xs text-clay">
          <div class="flex items-center gap-2">
            <span class="text-base">☎️</span>
            <span>জরুরি ডেলিভারি বা ঠিকানা পরিবর্তনের প্রয়োজন?</span>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <a
              id="whatsappConfirmLink"
              href={`https://wa.me/88${BRAND.supportPhone}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 rounded-[3px] bg-emerald-600 px-3 py-1.5 font-bengali text-xs font-semibold text-white hover:bg-emerald-700 transition-colors"
            >
              WhatsApp-এ কনফার্ম করুন
            </a>
            <a
              href={`tel:+88${BRAND.supportPhone}`}
              class="font-sans font-semibold text-espresso hover:text-gold-700 transition-colors"
            >
              +88{BRAND.supportPhone}
            </a>
            <span class="text-parchment-line">|</span>
            <a
              href="/contact"
              class="font-semibold text-gold-700 hover:text-ink underline transition-colors"
            >
              সাপোর্টে যোগাযোগ করুন →
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Script for Live Dynamic Fetching from Atlas Backend -->
  <script>
    import { trackOrderApi } from '../lib/api';

    async function loadLiveOrder(orderNumber: string) {
      const loadingBox = document.getElementById('loadingBox');
      const errorCard = document.getElementById('errorCard');
      const resultCard = document.getElementById('resultCard');

      if (!orderNumber || !loadingBox || !errorCard || !resultCard) return;

      loadingBox.classList.remove('hidden');
      errorCard.classList.add('hidden');
      resultCard.classList.add('hidden');

      try {
        const order = await trackOrderApi(orderNumber.trim());

        if (!order) throw new Error('Order data is empty');

        // Populate details
        const displayOrderNum = document.getElementById('displayOrderNum');
        const displayCustomer = document.getElementById('displayCustomer');
        const displayStatus = document.getElementById('displayStatus');
        if (displayOrderNum) displayOrderNum.textContent = order.orderNumber;
        if (displayCustomer) {
          displayCustomer.innerHTML = `প্রাপক: <strong class="text-espresso">${order.shippingAddress?.fullName || 'সম্মানিত গ্রাহক'}</strong> · ${order.shippingAddress?.district || 'ঢাকা'}`;
        }

        const statusMap: Record<string, string> = {
          pending: 'অর্ডার যাচাই প্রক্রিয়াধীন',
          processing: 'উপহার প্যাকিং ও সিলমোহর সম্পন্ন',
          shipped: 'কুরিয়ার ট্রানজিটে চলমান',
          delivered: 'সফলভাবে ডেলিভারি সম্পন্ন',
          cancelled: 'অর্ডার বাতিল করা হয়েছে'
        };
        if (displayStatus) displayStatus.textContent = statusMap[order.orderStatus] || order.orderStatus;

        // Items
        const itemsContainer = document.getElementById('displayItems');
        if (itemsContainer && order.items && order.items.length > 0) {
          itemsContainer.innerHTML = order.items.map((item: any) => `
            <div class="flex justify-between items-center py-1">
              <span>🎁 ${item.name} × ${item.quantity || 1}</span>
              <span class="font-sans font-semibold">৳${(item.price * (item.quantity || 1)).toLocaleString('en-US')}</span>
            </div>
          `).join('');
        }

        const displayTotal = document.getElementById('displayTotal');
        const displayPaymentMethod = document.getElementById('displayPaymentMethod');
        if (displayTotal) displayTotal.textContent = '৳' + (order.total || 0).toLocaleString('en-US');
        if (displayPaymentMethod) {
          displayPaymentMethod.textContent = `পেমেন্ট: ${(order.paymentMethod || 'COD').toUpperCase()} (${order.paymentStatus || 'pending'})`;
        }

        const whatsappLink = document.getElementById('whatsappConfirmLink') as HTMLAnchorElement | null;
        if (whatsappLink) {
          const msg = `হ্যালো মেঘপিয়ন! আমার অর্ডার নম্বর ${order.orderNumber} (মোট: ৳${order.total || 0}) কনফার্ম করতে চাই।`;
          const baseHref = whatsappLink.getAttribute('href')?.split('?')[0] || 'https://wa.me/8801789335268';
          whatsappLink.href = `${baseHref}?text=${encodeURIComponent(msg)}`;
        }

        // Timeline
        const timelineContainer = document.getElementById('displayTimeline');
        if (timelineContainer && order.timeline && order.timeline.length > 0) {
          timelineContainer.innerHTML = order.timeline.map((event: any, idx: number) => {
            const isLast = idx === order.timeline.length - 1;
            const eventDate = new Date(event.timestamp);
            const timeStr = eventDate.toLocaleTimeString('bn-BD', { hour: '2-digit', minute: '2-digit' });
            const dateStr = eventDate.toLocaleDateString('bn-BD', { day: 'numeric', month: 'short' });

            return `
              <div class="relative">
                <div class="absolute -left-[30px] top-0.5 grid h-5 w-5 place-items-center rounded-full ${isLast ? 'bg-gold-500 text-ink ring-4 ring-gold-200' : 'bg-ink text-gold-300 ring-4 ring-parchment'}">
                  ${isLast ? '<span class="h-2 w-2 rounded-full bg-ink animate-pulse"></span>' : '<svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" /></svg>'}
                </div>
                <div class="${isLast ? 'rounded-[4px] border border-gold-500/40 bg-gold-400/[0.08] p-3.5' : ''}">
                  <div class="flex flex-wrap items-center justify-between gap-1">
                    <h4 class="font-tiro text-base font-semibold text-espresso">
                      ${event.description}
                    </h4>
                    <span class="font-bengali text-[11px] font-medium text-clay/80">${dateStr}, ${timeStr}</span>
                  </div>
                  <p class="mt-1 font-bengali text-xs leading-relaxed text-clay">
                    ${event.location ? `${event.location} · ` : ''}স্ট্যাটাস: ${statusMap[event.status] || event.status}
                  </p>
                </div>
              </div>
            `;
          }).join('');
        }

        loadingBox.classList.add('hidden');
        resultCard.classList.remove('hidden');
      } catch (err) {
        loadingBox.classList.add('hidden');
        const errorMessage = document.getElementById('errorMessage');
        if (errorMessage) {
          errorMessage.textContent = `অর্ডার নম্বর '${orderNumber}' ডাটাবেজে পাওয়া যায়নি। অনুগ্রহ করে সঠিক ট্র্যাকিং নম্বর দিয়ে চেষ্টা করুন।`;
        }
        errorCard.classList.remove('hidden');
      }
    }

    // On Load
    const params = new URLSearchParams(window.location.search);
    const initialOrder = params.get('order') || 'MP-17403';
    const orderInput = document.getElementById('orderInput') as HTMLInputElement | null;
    if (orderInput) orderInput.value = initialOrder;
    loadLiveOrder(initialOrder);

    // Form submit listener
    const form = document.getElementById('trackForm');
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const num = orderInput?.value.trim();
      if (num) {
        history.pushState(null, '', `?order=${encodeURIComponent(num)}`);
        loadLiveOrder(num);
      }
    });
  </script>
</BaseLayout>
